{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": "python3 \"$(ghq root)/github.com/Fukuemon/kufu-apps/hooks/protected-branch/pre_tool_use.py\"",
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "type": "command",
        "command": "python3 \"$(ghq root)/github.com/Fukuemon/kufu-apps/hooks/protected-branch/pre_tool_use.py\"",
        "matcher": "Bash"
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "bash \"$(ghq root)/github.com/Fukuemon/kufu-apps/hooks/markdown/format_markdown.sh\"",
        "matcher": "Edit|Write"
      },
      {
        "type": "command",
        "command": "bash \"$(ghq root)/github.com/Fukuemon/kufu-apps/hooks/spec/validate_document.sh\"",
        "matcher": "Edit|Write"
      },
      {
        "type": "command",
        "command": "bash \"$(ghq root)/github.com/Fukuemon/kufu-apps/hooks/spec/validate_prompts.sh\"",
        "matcher": "Edit|Write"
      }
    ]
  }
}
