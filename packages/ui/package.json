{
  "name": "@kufu/ui",
  "version": "0.0.1",
  "private": true,
  "files": [
    "src",
    "components.json"
  ],
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/globals.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib": "./src/lib/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts --format esm --platform neutral --external react --external react-dom --out-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006",
    "storybook:build": "storybook build",
    "vrt:capture": "vitest run --project=storybook"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@fontsource-variable/noto-serif-jp": "^5.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@kufu/config": "workspace:*",
    "@storybook/addon-docs": "10.5.9",
    "@storybook/addon-vitest": "10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@storycap-testrun/browser": "2.1.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.59.1",
    "storybook": "^10.5.9",
    "tailwindcss": "^4.3.1",
    "tsdown": "^0.16.6",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vitest": "4.1.11"
  }
}
