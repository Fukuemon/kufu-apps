{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": ["./lint/plugin.mjs"],
  "rules": {
    "e2e/e2e-authoring-rule": [
      "error",
      {
        "testsDir": "tests",
        "fixedWaitAllowedFiles": ["tests/fixtures/caption.ts"],
        "timeoutDefinitionFile": "tests/fixtures/timeouts.ts"
      }
    ]
  }
}
