{
  "core": {
    "workingDir": ".reg",
    "actualDir": "__screenshots__",
    "thresholdRate": 0,
    "ximgdiff": {
      "invocationType": "client"
    }
  },
  "plugins": {
    "reg-keygen-git-hash-plugin": true,
    "reg-publish-s3-plugin": {
      "bucketName": "kufu-vrt-baseline",
      "enableACL": false,
      "sdkOptions": {
        "endpoint": "${VRT_S3_ENDPOINT}",
        "region": "auto",
        "forcePathStyle": true,
        "credentials": {
          "accessKeyId": "${VRT_S3_ACCESS_KEY_ID}",
          "secretAccessKey": "${VRT_S3_SECRET_ACCESS_KEY}"
        }
      }
    }
  }
}
