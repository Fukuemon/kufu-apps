{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "project": ["e2e/**/*.ts"]
    },
    "apps/corporate-site": {
      "entry": ["src/pages/**/*.astro"],
      "project": ["src/**/*.{astro,ts,css}", "public/**/*"],
      "ignoreDependencies": ["@kufu/ui"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx,css}", "components.json"],
      "ignoreDependencies": [
        "@fontsource-variable/geist-mono",
        "@fontsource-variable/noto-sans-jp",
        "@fontsource-variable/noto-serif-jp",
        "@kufu/config",
        "lucide-react",
        "shadcn",
        "storybook",
        "tw-animate-css"
      ]
    },
    "packages/config": {
      "project": ["tsconfig/**/*.json", "oxlint/**/*.json", "vitest/**/*.ts"]
    }
  }
}
