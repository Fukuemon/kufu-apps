{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "project": ["scripts/**/*.mjs"],
      "ignoreDependencies": ["http-server", "reg-cli"]
    },
    "e2e": {
      "entry": ["lint/plugin.mjs"],
      "project": ["**/*.{ts,mjs}"]
    },
    "apps/corporate-site": {
      "entry": [
        "src/pages/**/*.astro",
        ".storybook/{main,preview}.ts",
        "src/**/*.stories.@(ts|tsx)",
        "src/components/**/*.astro",
        "scripts/*.mjs"
      ],
      "project": [
        "src/**/*.{astro,ts,css}",
        "scripts/**/*.{mjs,ts}",
        "public/**/*"
      ],
      "ignoreDependencies": ["sharp"],
      "ignore": ["scripts/__fixtures__/**"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx,css}"]
    }
  },
  "ignoreDependencies": [
    "textlint-rule-no-mix-dearu-desumasu",
    "textlint-rule-preset-ai-words-ja",
    "textlint-rule-prh",
    "textlint-rule-sentence-length"
  ]
}
