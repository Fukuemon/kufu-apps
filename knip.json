{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "project": ["e2e/**/*.ts", "scripts/**/*.mjs"],
      "ignoreDependencies": [
        "storycap",
        "http-server",
        "reg-suit",
        "reg-keygen-git-hash-plugin",
        "reg-publish-s3-plugin"
      ]
    },
    "apps/corporate-site": {
      "entry": [
        "src/pages/**/*.astro",
        ".storybook/{main,preview}.ts",
        "src/**/*.stories.@(ts|tsx)",
        "src/components/**/*.astro",
        "scripts/*.mjs"
      ],
      "project": [
        "src/**/*.{astro,ts,css}",
        "scripts/**/*.{mjs,ts}",
        "public/**/*"
      ],
      "ignoreDependencies": ["sharp"],
      "ignore": ["scripts/__fixtures__/**"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx,css}", "components.json"],
      "ignoreDependencies": ["@kufu/config"]
    },
    "packages/config": {
      "project": ["tsconfig/**/*.json", "oxlint/**/*.json", "vitest/**/*.ts"]
    }
  }
}
