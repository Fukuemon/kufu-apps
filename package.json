{
  "name": "kufu-apps",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "dev": "pnpm -r --parallel dev",
    "dev:corporate": "pnpm --filter @kufu/corporate-site dev",
    "build": "pnpm -r build",
    "check": "vp check && pnpm -r check",
    "check:fix": "vp check --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @kufu/e2e e2e",
    "storybook": "pnpm --parallel --filter @kufu/ui --filter @kufu/corporate-site storybook",
    "storybook:ui": "pnpm --filter @kufu/ui storybook",
    "storybook:corporate": "pnpm --filter @kufu/corporate-site storybook",
    "storybook:build": "pnpm --filter @kufu/ui storybook:build && pnpm --filter @kufu/corporate-site storybook:build",
    "storybook:pages": "pnpm storybook:build && node scripts/build-storybook-pages.mjs",
    "vrt:story": "node scripts/vrt-story.mjs",
    "vrt:story:update": "node scripts/vrt-story.mjs --update",
    "vrt:route": "node scripts/vrt-container.mjs vrt:route:run",
    "vrt:route:update": "node scripts/vrt-container.mjs vrt:route:run --update-snapshots",
    "vrt:route:run": "pnpm --filter @kufu/e2e vrt:route:run",
    "knip": "knip",
    "depcruise": "dependency-cruiser .",
    "check:specs": "bash scripts/check-specs-residue.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^25.6.2",
    "dependency-cruiser": "^17.3.1",
    "http-server": "14.1.1",
    "knip": "^5.67.1",
    "lefthook": "^2.2.1",
    "reg-cli": "0.18.16",
    "textlint": "^15.8.0",
    "textlint-rule-no-mix-dearu-desumasu": "^6.0.4",
    "textlint-rule-preset-ai-words-ja": "^1.2.1",
    "textlint-rule-prh": "^6.1.0",
    "textlint-rule-sentence-length": "^5.2.1",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.27.0"
}
