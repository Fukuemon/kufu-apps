{
  "name": "kufu-apps",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:corporate": "turbo run dev --filter=@kufu/corporate-site",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "test": "turbo run test",
    "e2e": "playwright test",
    "storybook": "pnpm --parallel --filter @kufu/ui --filter @kufu/corporate-site storybook",
    "storybook:ui": "pnpm --filter @kufu/ui storybook",
    "storybook:corporate": "pnpm --filter @kufu/corporate-site storybook",
    "storybook:build": "pnpm --filter @kufu/ui storybook:build && pnpm --filter @kufu/corporate-site storybook:build",
    "storybook:pages": "pnpm storybook:build && node scripts/build-storybook-pages.mjs",
    "vrt:route": "node scripts/vrt-route.mjs",
    "vrt:route:update": "node scripts/vrt-route.mjs --update-snapshots",
    "vrt:story": "node --env-file-if-exists=.env scripts/vrt-story.mjs",
    "vrt:story:baseline": "node --env-file-if-exists=.env scripts/vrt-story.mjs --no-fail-on-diff",
    "knip": "knip",
    "depcruise": "dependency-cruiser .",
    "check:specs": "bash scripts/check-specs-residue.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^25.6.2",
    "dependency-cruiser": "^17.3.1",
    "http-server": "14.1.1",
    "knip": "^5.67.1",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "reg-keygen-git-hash-plugin": "0.14.5",
    "reg-publish-s3-plugin": "0.14.4",
    "reg-suit": "0.14.5",
    "storycap": "5.0.1",
    "turbo": "^2.9.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "overrides": {
      "vite": "^7"
    }
  }
}
