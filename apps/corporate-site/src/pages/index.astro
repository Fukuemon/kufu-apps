---
import BaseLayout from "../components/common/BaseLayout.astro";
---

<BaseLayout
  title="有限会社フクウラ"
  description="有限会社フクウラは、機械工具・省力化機器・伝動機器・各種加工の相談に対応します。"
  footerVariant="full"
>
  <section
    class="mx-auto flex min-h-120 w-full max-w-360 flex-col justify-center gap-6 px-5 py-20 sm:px-8 lg:px-14"
    data-testid="home-section-hero"
  >
    <p class="font-mono text-xs font-medium tracking-[0.18em] text-primary">
      FUKUURA INDUSTRIAL SUPPLY
    </p>
    <h1 class="max-w-210 font-serif text-4xl font-semibold leading-tight md:text-6xl">
      「創意」と「誠意」で真心奉仕
    </h1>
    <p class="max-w-170 text-base leading-8 text-muted-foreground">
      LP section は後続 prompt で実装します。
    </p>
  </section>
</BaseLayout>
