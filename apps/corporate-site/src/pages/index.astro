---
import BaseLayout from "../components/common/BaseLayout.astro";
import ContactBand from "../components/common/ContactBand.astro";
import { BusinessSection } from "../components/sections/business";
import { CompanySection } from "../components/sections/company";
import { ConsultationSection } from "../components/sections/consultation";
import { Hero } from "../components/sections/hero";
import { ProductsCategorySection } from "../components/sections/products-category";
import { contactPageContent } from "../content/contact.js";
---

<BaseLayout
  title="有限会社フクウラ"
  description="有限会社フクウラは、機械工具・省力化機器・伝動機器・各種加工・小規模工事の相談に対応します。"
>
  <Hero />
  <ConsultationSection number="01" />
  <BusinessSection number="02" />
  <ProductsCategorySection number="03" />
  <CompanySection number="04" />
  <ContactBand
    title={contactPageContent.title}
    lead={contactPageContent.lead}
    data-testid="home-section-contact-band"
  />
</BaseLayout>
