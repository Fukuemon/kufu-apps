---
import BaseLayout from "../components/common/BaseLayout.astro";
import ContactBand from "../components/common/ContactBand.astro";
import { ProductsDetailSection } from "../components/sections/products-detail";
import { productsContactBandContent } from "../content/products.js";
---

<BaseLayout
  title="取扱製品 | 有限会社フクウラ"
  description="有限会社フクウラの取扱製品カテゴリとメーカー一覧。"
>
  <ProductsDetailSection />
  <ContactBand
    title={productsContactBandContent.title}
    lead={productsContactBandContent.lead}
    data-testid="products-section-contact-band"
  />
</BaseLayout>
