---
import { Button, Tag } from "@kufu/ui";

import { companyProfile } from "../../../content/company.js";
import { contactInfo, contactPageContent } from "../../../content/contact.js";
---

<section class="bg-surface-canvas">
  <div class="mx-auto grid w-full max-w-360 gap-8 px-5 pb-18 pt-12 sm:px-8 md:gap-10 lg:px-14">
    <div class="grid gap-4">
      <nav class="flex gap-2 font-mono text-label tracking-[0.14em] text-text-secondary" aria-label="パンくず">
        <a class="focus-ring" href="/">{contactPageContent.breadcrumb.home}</a>
        <span>/</span>
        <span>{contactPageContent.breadcrumb.current}</span>
      </nav>
      <h1 class="font-serif text-heading-36 font-semibold leading-tight md:text-display-57">
        {contactPageContent.title}
      </h1>
      <p class="max-w-190 text-body leading-[1.75] text-text-secondary">
        {contactPageContent.lead}
      </p>
    </div>

    <div class="grid gap-7 lg:grid-cols-[22.5rem_1fr]">
      <section
        class="grid content-start gap-4 bg-surface p-6"
        data-testid="contact-section-info"
      >
        <div class="grid gap-1.5">
          <p class="font-mono text-eyebrow tracking-[0.16em] text-primary">{contactPageContent.infoLabels.tel}</p>
          <a class="focus-ring text-body" href={contactInfo.telHref}>
            {contactInfo.tel}
          </a>
        </div>
        <div class="grid gap-1.5">
          <p class="font-mono text-eyebrow tracking-[0.16em] text-primary">{contactPageContent.infoLabels.fax}</p>
          <p class="text-body">{contactInfo.fax}</p>
        </div>
        <div class="grid gap-1.5">
          <p class="font-mono text-eyebrow tracking-[0.16em] text-primary">{contactPageContent.infoLabels.email}</p>
          <a class="focus-ring text-body" href={contactInfo.emailHref}>
            {contactInfo.email}
          </a>
        </div>
        <div class="grid gap-1.5">
          <p class="font-mono text-caption tracking-[0.16em] text-primary">{contactPageContent.infoLabels.address}</p>
          <p class="text-body">
            {companyProfile.postalCode}<br />{companyProfile.streetAddress}
          </p>
        </div>
        <p class="pt-2 text-caption leading-[1.75] text-text-secondary">
          {contactPageContent.notice.hours}<br />
          {contactPageContent.notice.estimate}
        </p>
      </section>

      <section
        class="grid gap-4 bg-surface p-6"
        data-testid="contact-form-slot"
        aria-label="問い合わせフォーム"
      >
        <div class="grid gap-4 md:grid-cols-2">
          <label class="grid gap-2 text-label">
            <span class="flex items-center gap-2">会社名<Tag size="sm" tone="required">必須</Tag></span>
            <input class="focus-ring min-h-12 border border-field bg-surface-canvas px-3 text-body-dense" type="text" name="company" required aria-required="true" />
          </label>
          <label class="grid gap-2 text-label">
            <span class="flex items-center gap-2">ご担当者名<Tag size="sm" tone="required">必須</Tag></span>
            <input class="focus-ring min-h-12 border border-field bg-surface-canvas px-3 text-body-dense" type="text" name="name" required aria-required="true" />
          </label>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          <label class="grid gap-2 text-label">
            <span class="flex items-center gap-2">メールアドレス<Tag size="sm" tone="required">必須</Tag></span>
            <input class="focus-ring min-h-12 border border-field bg-surface-canvas px-3 text-body-dense" type="email" name="email" required aria-required="true" />
          </label>
          <label class="grid gap-2 text-label">
            <span class="flex items-center gap-2">電話番号<Tag size="sm" tone="required">必須</Tag></span>
            <input class="focus-ring min-h-12 border border-field bg-surface-canvas px-3 text-body-dense" type="tel" name="phone" required aria-required="true" />
          </label>
        </div>
        <label class="grid gap-2 text-label">
          <span class="flex items-center gap-2">住所<Tag size="sm" tone="required">必須</Tag></span>
          <input class="focus-ring min-h-12 border border-field bg-surface-canvas px-3 text-body-dense" type="text" name="address" autocomplete="street-address" placeholder={companyProfile.address} required aria-required="true" />
        </label>
        <div class="grid gap-4 md:grid-cols-2">
          <label class="grid gap-2 text-label">
            <span class="flex items-center gap-2">FAX番号<Tag size="sm" tone="optional">任意</Tag></span>
            <input class="focus-ring min-h-12 border border-field bg-surface-canvas px-3 text-body-dense" type="tel" name="fax" autocomplete="fax" />
          </label>
          <label class="grid gap-2 text-label">
            <span class="flex items-center gap-2">お問い合わせ種別<Tag size="sm" tone="optional">任意</Tag></span>
            <select class="focus-ring min-h-12 border border-field bg-surface-canvas px-3 text-body-dense text-text-secondary" name="category">
              <option>お見積り依頼（販売）</option>
              <option>加工のご相談</option>
              <option>その他</option>
            </select>
          </label>
        </div>
        <label class="grid gap-2 text-label">
          <span class="flex items-center gap-2">お問い合わせ内容<Tag size="sm" tone="required">必須</Tag></span>
          <textarea class="focus-ring min-h-40 border border-field bg-surface-canvas p-3 text-body-dense leading-[1.75] text-text-secondary" name="message" required aria-required="true">製品名・型番・数量、加工内容（図面の有無）などをご記入ください。</textarea>
        </label>
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <p class="text-caption text-text-secondary">
            ※ こちらはデザイン確認用のフォーム枠です。
          </p>
          <Button type="button" variant="cta" size="cta-md">
            送信する
            <span class="font-mono" aria-hidden="true">→</span>
          </Button>
        </div>
      </section>
    </div>
  </div>
</section>
