---
import type { CollectionEntry } from "astro:content";

import FeaturedCategoryCard from "./FeaturedCategoryCard.astro";

export interface Props {
  categories: CollectionEntry<"productCategories">[];
  makerCountsByCategoryId: Record<string, number>;
}

const { categories, makerCountsByCategoryId } = Astro.props;
---

<div
  data-reveal
  class="featured-carousel relative min-w-0"
  data-testid="home-products-carousel"
  data-featured-carousel
>
  {/* カードのフォーカスの表示（外へ 6px）を overflow で切らないよう、p-1.5 で内側に余白を取り、-m-1.5 で位置を戻す */}
  <div
    class="focus-ring featured-carousel-viewport -m-1.5 flex min-w-0 gap-5 overflow-x-auto p-1.5"
    data-carousel-track
    tabindex="0"
    role="group"
    aria-label="取扱製品カテゴリ カルーセル（横スクロール・左右ボタンで操作）"
  >
    {
      categories.map((category) => (
        <div class="featured-carousel-item w-64 shrink-0">
          <FeaturedCategoryCard
            category={String(category.data.order).padStart(2, "0")}
            count={`${makerCountsByCategoryId[category.id] ?? 0}社`}
            title={`${category.data.name}`}
            image={category.data.featuredImage}
            href={`/products#${category.id}`}
          />
        </div>
      ))
    }
  </div>
  {/* 矢印は、initFeaturedCarousel が横にあふれるときだけ出す。JS が無効のときは、横のスクロールだけで送る */}
  <button
    type="button"
    class="focus-ring featured-carousel-arrow featured-carousel-arrow--prev"
    data-carousel-prev
    aria-label="前のカテゴリ"
    aria-disabled="true"
    hidden
  >
    ←
  </button>
  <button
    type="button"
    class="focus-ring featured-carousel-arrow featured-carousel-arrow--next"
    data-carousel-next
    aria-label="次のカテゴリ"
    hidden
  >
    →
  </button>
</div>

<script>
  import { initFeaturedCarousel } from "./featured-carousel.js";

  const carousel = document.querySelector<HTMLElement>("[data-featured-carousel]");
  if (carousel) initFeaturedCarousel(carousel);
</script>
