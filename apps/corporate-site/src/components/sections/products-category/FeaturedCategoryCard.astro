---
export interface Props {
  category: string;
  count?: string;
  title: string;
  image?: string;
}

const { category, count, title, image } = Astro.props;
---

<article data-reveal class="featured-category-card flex min-w-0 flex-col overflow-hidden border border-divider bg-surface text-text">
  <div
    class="featured-category-media h-[9.375rem] bg-surface-subtle bg-cover bg-center bg-blend-multiply"
    style={image ? `background-image: linear-gradient(var(--kufu-color-overlay-photo), var(--kufu-color-overlay-photo)), url(${image})` : undefined}
  >
  </div>
  <div class="flex flex-col gap-2 px-4 pt-3.5 pb-4">
    {/* count の有無で行の高さがずれないよう、子の p の行高を leading-4 で揃える。文字のスタイルは自分の行高を持ち、親の leading を継がない */}
    <div class="flex items-center justify-between">
      <p
        class="font-mono text-eyebrow leading-4 font-medium tracking-[0.09em] text-primary"
      >
        {category}
      </p>
      {
        count ? (
          <p class="text-caption leading-4 text-text-secondary">{count}</p>
        ) : null
      }
    </div>
    <p class="text-heading-16 font-semibold leading-normal text-text">
      {title}
    </p>
  </div>
</article>
