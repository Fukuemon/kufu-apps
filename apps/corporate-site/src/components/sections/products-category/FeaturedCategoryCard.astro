---
export interface Props {
  category: string;
  count?: string;
  title: string;
  image?: string;
}

const { category, count, title, image } = Astro.props;
---

<article class="featured-category-card flex min-w-0 flex-col overflow-hidden border border-divider bg-surface text-text">
  <div
    class="featured-category-media h-[9.375rem] bg-surface-subtle bg-cover bg-center bg-blend-multiply"
    style={image ? `background-image: linear-gradient(var(--kufu-color-overlay-photo), var(--kufu-color-overlay-photo)), url(${image})` : undefined}
  >
  </div>
  <div class="flex flex-col gap-2 px-4 pt-3.5 pb-4">
    {/* count の有無でフォントサイズ差による行高ずれが出ないよう leading-4 固定 */}
    <div class="flex items-center justify-between leading-4">
      <p
        class="font-mono text-[0.6875rem] font-medium tracking-[0.09em] text-primary"
      >
        {category}
      </p>
      {
        count ? (
          <p class="text-[0.71875rem] text-text-secondary">{count}</p>
        ) : null
      }
    </div>
    <p class="text-[0.9375rem] font-semibold leading-normal text-text">
      {title}
    </p>
  </div>
</article>
