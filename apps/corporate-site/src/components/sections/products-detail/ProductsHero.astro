---
import { Image } from "astro:assets";

import ContactCtaLink from "../../common/ContactCtaLink.astro";
import productsImage from "../../../assets/corporate-products-supply.png";
import { productsHeroContent } from "../../../content/products.js";
---

<section class="relative overflow-hidden bg-surface-canvas">
  <div class="relative z-1 mx-auto grid w-full max-w-360 gap-10 px-5 py-12 sm:px-8 md:gap-16 md:py-16 lg:px-14">
    <div class="grid gap-10 lg:min-h-[28rem] lg:grid-cols-[38.125rem_1fr] lg:items-center">
      <div data-reveal class="grid gap-5">
        <nav class="flex gap-2 font-mono text-label tracking-[0.12em] text-text-secondary" aria-label="パンくず">
          <a class="focus-ring" href="/">{productsHeroContent.breadcrumb.home}</a>
          <span>/</span>
          <span class="text-primary">{productsHeroContent.breadcrumb.current}</span>
        </nav>
        <p class="font-mono text-eyebrow font-medium tracking-[0.22em] text-primary">
          {productsHeroContent.eyebrow}
        </p>
        <h1 class="max-w-152 font-serif text-heading-36 font-semibold leading-[1.22] md:text-display-48">
          {productsHeroContent.title}
        </h1>
        <p class="max-w-148 text-body leading-[1.85] text-text-secondary">
          {productsHeroContent.lead}
        </p>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
          <ContactCtaLink href={productsHeroContent.primaryCta.href} size="lg" data-testid="products-link-contact">
            {productsHeroContent.primaryCta.label}{" "}
            <span class="font-mono" aria-hidden="true">→</span>
          </ContactCtaLink>
          <a class="focus-ring text-label font-medium" href={productsHeroContent.secondaryCta.href}>
            {productsHeroContent.secondaryCta.label}
          </a>
        </div>
      </div>
      <div data-reveal class="products-hero-media relative min-h-[26.25rem] overflow-hidden border border-divider bg-surface-media">
        <Image
          src={productsImage}
          alt={productsHeroContent.imageAlt}
          width={784}
          height={502}
          widths={[392, 784, 1176]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="products-hero-media-overlay absolute inset-0 bg-overlay-photo" aria-hidden="true"></div>
        <div class="products-hero-media-caption absolute bottom-6 left-6 bg-overlay-panel px-4 py-3">
          <p class="text-body font-semibold">{productsHeroContent.mediaCaption.title}</p>
          <p class="mt-1 font-mono text-caption tracking-[0.1em] text-text-secondary">
            {productsHeroContent.mediaCaption.sub}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
