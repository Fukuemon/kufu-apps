---
import type { CollectionEntry } from "astro:content";

export interface Props {
  categoryGroups: {
    title: string;
    items: { category: CollectionEntry<"productCategories"> }[];
  }[];
  makerCountById: Record<string, number>;
}

const { categoryGroups, makerCountById } = Astro.props;
---

<aside data-reveal class="products-nav-rail lg:sticky lg:top-28 lg:self-start">
  <details id="products-nav" class="products-nav scroll-mt-24 border border-divider bg-surface" open data-products-nav>
    <summary class="focus-ring products-nav-summary flex cursor-pointer items-center justify-between gap-3 px-5 py-4 lg:hidden">
      <span class="text-label font-semibold">カテゴリを探す</span>
      <span class="products-nav-summary-icon font-mono text-label text-text-secondary" aria-hidden="true">▾</span>
    </summary>

    <div class="grid gap-4 px-5 pb-5 lg:pt-5">
      <label class="grid gap-2">
        <span class="sr-only">カテゴリ・メーカー名で検索</span>
        <span class="relative block">
          <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 font-mono text-label text-text-secondary" aria-hidden="true">⌕</span>
          <input
            type="search"
            class="focus-ring min-h-11 w-full border border-divider bg-surface-canvas pl-9 pr-3 text-body-dense"
            placeholder="カテゴリ・メーカー名で検索"
            aria-controls="products-category-groups"
            data-products-search
          />
        </span>
      </label>

      <div class="flex items-center justify-between gap-3">
        <p class="text-caption text-text-secondary" data-products-result aria-live="polite" hidden></p>
        <div class="ml-auto flex gap-2">
          <button type="button" class="focus-ring products-control-btn" data-expand-all>すべて開く</button>
          <button type="button" class="focus-ring products-control-btn" data-collapse-all>すべて閉じる</button>
        </div>
      </div>

      <nav
        id="products-category-list"
        class="products-nav-list grid scroll-mt-24 gap-4 lg:-m-1.5 lg:max-h-[calc(100vh-18rem)] lg:scroll-p-1.5 lg:overflow-y-auto lg:p-1.5"
        aria-label="取扱製品カテゴリ索引"
        data-testid="products-category-list"
        data-category-nav
      >
        {
          categoryGroups.map((group) => (
            <div class="grid gap-0.5" data-products-nav-group>
              <p class="products-nav-group-title font-mono text-caption font-medium tracking-[0.16em] text-text-secondary">
                {group.title}
              </p>
              <ul class="grid list-none">
                {group.items.map(({ category }) => (
                  <li>
                    <a
                      class="focus-ring products-nav-link grid grid-cols-[1.75rem_1fr_auto] items-center gap-2 py-1.5 hover:text-primary"
                      href={`#${category.id}`}
                      data-nav-target={category.id}
                    >
                      <span class="font-mono text-eyebrow font-medium tracking-[0.08em] text-primary">
                        {String(category.data.order).padStart(2, "0")}
                      </span>
                      <span class="text-label font-medium leading-snug">
                        {category.data.name}
                      </span>
                      <span class="text-caption text-text-secondary">
                        {makerCountById[category.id] ?? 0}社
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
  </details>
</aside>
