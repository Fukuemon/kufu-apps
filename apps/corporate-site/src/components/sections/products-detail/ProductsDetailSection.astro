---
import { getCollection } from "astro:content";

import ProductsCategoryAccordionList from "./ProductsCategoryAccordionList.astro";
import ProductsHero from "./ProductsHero.astro";
import ProductsSidebarNav from "./ProductsSidebarNav.astro";
import { productGroups } from "../../../content/product-groups.js";
import { productsIndexContent } from "../../../content/products.js";

const productCategories = (await getCollection("productCategories")).sort(
  (a, b) => a.data.order - b.data.order,
);
const categoryMakers = (await getCollection("categoryMakers")).sort(
  (a, b) => a.data.order - b.data.order,
);

const makersByCategory = new Map(
  categoryMakers.map((entry) => [entry.data.categoryId, entry]),
);

const categoriesWithMakers = productCategories.map((category) => {
  const makers = makersByCategory.get(category.id);

  if (!makers) {
    throw new Error(`Missing makers for product category: ${category.id}`);
  }

  return {
    category,
    makers,
  };
});

const makerCountById = Object.fromEntries(
  categoryMakers.map((entry) => [entry.data.categoryId, entry.data.makers.length]),
);

// design: Products Category List はカテゴリを groupId 単位の見出しで束ねる
const groupTitleById: Record<string, string> = Object.fromEntries(
  productGroups.map((group) => [group.id, group.title]),
);

const itemsByGroupId = new Map<string, typeof categoriesWithMakers>();
for (const item of categoriesWithMakers) {
  const groupId = item.category.data.groupId;
  const items = itemsByGroupId.get(groupId) ?? [];
  items.push(item);
  itemsByGroupId.set(groupId, items);
}

const categoryGroups = [...itemsByGroupId.entries()].map(([groupId, items]) => {
  const orders = items.map(({ category }) => category.data.order);

  return {
    eyebrow: `${String(Math.min(...orders)).padStart(2, "0")}–${String(Math.max(...orders)).padStart(2, "0")}`,
    title: groupTitleById[groupId] ?? groupId,
    items,
  };
});
---

<ProductsHero />

<section class="bg-surface-subtle" data-testid="products-section-index">
  <div class="mx-auto grid w-full max-w-360 gap-8 px-5 py-14 sm:px-8 md:gap-10 md:py-20 lg:px-14">
    <div class="grid gap-4">
      <h2 class="font-serif text-heading-32 font-semibold leading-[1.45] md:text-heading-45">
        {productsIndexContent.title}
      </h2>
      <p class="max-w-180 text-body leading-[1.75] text-text-secondary">
        {productsIndexContent.lead}
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-[19.5rem_minmax(0,1fr)] lg:items-start lg:gap-10">
      <ProductsSidebarNav categoryGroups={categoryGroups} makerCountById={makerCountById} />
      <ProductsCategoryAccordionList categoryGroups={categoryGroups} />
    </div>
    <script is:inline>
      // 幅 1024px 未満では、索引と一覧を閉じて始める。HTML は開いた形で持つので、
      // スクリプトを動かせない端末では開いた形で出る。開いた形が描画されてから閉じると
      // ページの高さが跳ねるので、モジュールのスクリプトを待たずに、ここで同期に閉じる。
      // 開いたまま残す条件は docs/screens/product-list_取扱製品/index.md の「全体動作」にある。
      // 幅の条件と `q` の名前は、下のモジュールのスクリプトにも同じ値がある。
      (() => {
        if (window.matchMedia("(min-width: 64rem)").matches) return;

        const url = new URL(window.location.href);
        const hasQuery = (url.searchParams.get("q") ?? "").trim() !== "";
        // カテゴリと索引の id は ASCII なので、hash をデコードせずに比べる。ASCII でない id を足すときは、try で包んでデコードする
        const hashId = url.hash.slice(1);
        const hashTarget = hashId === "" ? null : document.getElementById(hashId);
        const nav = document.querySelector("[data-products-nav]");

        // hash が索引の外枠そのもの（ヒーローの「カテゴリ一覧を見る」の行き先）のときは、閉じて始める
        const hashInsideNav = hashTarget !== null && hashTarget !== nav && nav?.contains(hashTarget);
        if (nav && !hasQuery && !hashInsideNav) {
          nav.open = false;
        }
        document.querySelectorAll("[data-category-item]").forEach((item) => {
          const details = item.querySelector("details");
          if (details && item.id !== hashId) {
            details.open = false;
          }
        });
      })();
    </script>
  </div>

  <button
    type="button"
    class="focus-ring products-backtop"
    data-products-backtop
    aria-label="カテゴリ一覧の先頭へ戻る"
    hidden
  >
    <span class="font-mono text-label leading-none" aria-hidden="true">↑</span>
    <span class="products-backtop-label">カテゴリ先頭へ</span>
  </button>
</section>

<script>
  // 幅 1024px 未満で閉じて始める処理は、上の is:inline のスクリプトにある。
  // このセクション横断スクリプトが依存する DOM の所有元:
  //   - [data-products-nav] [data-products-search] [data-expand-all]
  //     [data-collapse-all] [data-nav-target] : ProductsSidebarNav.astro
  //   - [data-category-item] [data-products-group] [data-maker-list]
  //     [data-products-empty] #products-category-groups : ProductsCategoryAccordionList.astro
  //   - [data-products-backtop] : このファイル (assembly 層)
  // 上記コンポーネントの data-* / id と、幅の条件と `q` の名前を変更する場合は、このスクリプトと上の is:inline のスクリプトも合わせて更新する。
  const normalize = (value: string) =>
    value.toLowerCase().normalize("NFKC").replace(/\s+/g, "");

  const search = document.querySelector<HTMLInputElement>("[data-products-search]");
  const result = document.querySelector<HTMLElement>("[data-products-result]");
  const empty = document.querySelector<HTMLElement>("[data-products-empty]");
  const items = Array.from(
    document.querySelectorAll<HTMLElement>("[data-category-item]"),
  );
  const groups = Array.from(
    document.querySelectorAll<HTMLElement>("[data-products-group]"),
  );
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-target]"),
  );

  // 幅 1024px 以上では索引の見出しを隠すので、狭い幅で閉じた索引は、広げたときに開く
  const nav = document.querySelector<HTMLDetailsElement>("[data-products-nav]");
  const wideQuery = window.matchMedia("(min-width: 64rem)");
  wideQuery.addEventListener("change", (event) => {
    if (event.matches && nav) nav.open = true;
  });

  // 検索: カテゴリ名 / メーカー名で絞り込み、一致した accordion を開く
  const applyFilter = (raw: string) => {
    const query = normalize(raw);
    let matchCount = 0;

    items.forEach((item) => {
      const details = item.querySelector<HTMLDetailsElement>("details");
      const makers = Array.from(item.querySelectorAll<HTMLElement>("[data-maker]"));
      const nameMatch = normalize(item.dataset.categoryName ?? "").includes(query);

      let makerMatch = false;
      makers.forEach((maker) => {
        const hit =
          query === "" || nameMatch ||
          normalize(maker.dataset.maker ?? "").includes(query);
        maker.hidden = !hit;
        if (hit && query !== "") {
          makerMatch = true;
        }
      });

      const visible = query === "" || nameMatch || makerMatch;
      item.hidden = !visible;
      if (visible) {
        matchCount += 1;
      }
      if (details && query !== "" && visible) {
        details.open = true;
      }
    });

    groups.forEach((group) => {
      const anyVisible = group.querySelector<HTMLElement>(
        "[data-category-item]:not([hidden])",
      );
      group.hidden = !anyVisible;
    });

    navLinks.forEach((link) => {
      const target = link.dataset.navTarget ?? "";
      const item = document.getElementById(target);
      link.classList.toggle("is-dimmed", Boolean(item?.hidden));
    });

    if (result) {
      if (query === "") {
        result.hidden = true;
      } else {
        result.hidden = false;
        result.textContent = `${matchCount}件のカテゴリが一致`;
      }
    }
    if (empty) {
      empty.classList.toggle("hidden", matchCount !== 0);
    }
  };

  const searchParam = "q";

  const readSearchFromUrl = () =>
    new URL(window.location.href).searchParams.get(searchParam) ?? "";

  const applySearchFromUrl = () => {
    if (!search) return;

    const value = readSearchFromUrl();
    search.value = value;
    applyFilter(value);
  };

  const writeSearchToUrl = (value: string) => {
    const url = new URL(window.location.href);
    const query = value.trim();

    if (query === "") {
      url.searchParams.delete(searchParam);
    } else {
      url.searchParams.set(searchParam, query);
    }

    window.history.replaceState(
      window.history.state,
      "",
      `${url.pathname}${url.search}${url.hash}`,
    );
  };

  search?.addEventListener("input", () => {
    applyFilter(search.value);
    writeSearchToUrl(search.value);
  });
  window.addEventListener("popstate", applySearchFromUrl);
  applySearchFromUrl();

  document
    .querySelector("[data-expand-all]")
    ?.addEventListener("click", () => {
      items.forEach((item) => {
        const details = item.querySelector<HTMLDetailsElement>("details");
        if (details) details.open = true;
      });
    });

  document
    .querySelector("[data-collapse-all]")
    ?.addEventListener("click", () => {
      items.forEach((item) => {
        const details = item.querySelector<HTMLDetailsElement>("details");
        if (details) details.open = false;
      });
    });

  // scrollspy: 索引ナビの現在地をハイライト
  if (items.length > 0) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const id = entry.target.id;
          navLinks.forEach((link) =>
            link.classList.toggle(
              "is-active",
              link.dataset.navTarget === id,
            ),
          );
        });
      },
      { rootMargin: "-30% 0px -60% 0px", threshold: 0 },
    );
    items.forEach((item) => spy.observe(item));
  }

  // カテゴリ一覧セクションにいる間だけ「先頭へ戻る」ボタンを表示
  const backtop = document.querySelector<HTMLButtonElement>("[data-products-backtop]");
  const categoryGroups = document.getElementById("products-category-groups");

  if (backtop && categoryGroups && nav) {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          backtop.hidden = !entry.isIntersecting;
        });
      },
      { rootMargin: "-15% 0px -10% 0px", threshold: 0 },
    );
    sectionObserver.observe(categoryGroups);

    backtop.addEventListener("click", () => {
      // behavior を書かず、html の scroll-behavior に従わせる。動きを減らす設定のときは theme.css が滑らかなスクロールを止める
      // 索引を閉じていても移れるよう、閉じても描画される索引の外枠へ移る
      nav.scrollIntoView({ block: "start" });
    });
  }
</script>
