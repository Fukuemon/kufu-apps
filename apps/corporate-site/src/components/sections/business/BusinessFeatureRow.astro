---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  number?: string;
  eyebrow: string;
  title: string;
  description: string;
  items: string[];
  mediaLabel: string;
  mediaCaption: string;
  mediaPosition: "left" | "right";
  image?: ImageMetadata;
  imageLoading?: "eager" | "lazy";
}

const {
  number,
  eyebrow,
  title,
  description,
  items,
  mediaLabel,
  mediaCaption,
  mediaPosition,
  image,
  imageLoading = "lazy",
} = Astro.props;
const mediaPositionClass = {
  left: "min-[760px]:order-[-1]",
  right: "",
};
---

<article
  class="business-row flex w-full flex-col gap-6 border-t border-divider py-8 text-text last:border-b min-[760px]:min-h-[32rem] min-[760px]:flex-row min-[760px]:items-center min-[760px]:gap-14 min-[760px]:py-14"
>
  <div
    class="business-row-copy relative flex flex-col gap-4 min-[760px]:flex-[0_0_30rem] min-[760px]:w-120"
  >
    {
      number ? (
        <span
          class="pointer-events-none absolute -top-8.5 -left-2.5 z-0 font-mono text-watermark-120 font-medium leading-none text-text-ghost md:text-watermark-140"
          aria-hidden="true"
        >
          {number}
        </span>
      ) : null
    }
    <p
      class="relative z-1 text-primary font-mono text-eyebrow font-normal tracking-[0.16em]"
    >
      {eyebrow}
    </p>
    <h3
      class="relative z-1 font-serif text-heading-28 font-semibold leading-[1.45]"
    >
      {title}
    </h3>
    <p
      class="relative z-1 text-text-secondary text-body leading-[1.75]"
    >
      {description}
    </p>
    <ul class="relative z-1 flex flex-wrap gap-2 pt-1.5 list-none">
      {
        items.map((item) => (
          <li class="business-tag bg-surface-subtle px-3 py-1.5 text-caption leading-[1.4] text-text">
            {item}
          </li>
        ))
      }
    </ul>
  </div>
  <div
    class:list={[
      "business-media relative flex min-h-[18.75rem] items-end overflow-hidden bg-surface-media p-5 min-[760px]:min-h-[27.5rem] min-[760px]:flex-[1_1_auto]",
      mediaPositionClass[mediaPosition],
    ]}
  >
    {
      image ? (
        <Image
          src={image}
          alt={mediaCaption}
          width={768}
          height={512}
          widths={[384, 768, 1152]}
          sizes="(min-width: 760px) 50vw, 100vw"
          format="webp"
          loading={imageLoading}
          class="business-media-image absolute inset-0 h-full w-full object-cover"
        />
      ) : null
    }
    <div class="absolute inset-0 bg-overlay-photo" aria-hidden="true"></div>
    <div class="business-media-grid" aria-hidden="true"></div>
    <span class="surface-inverse relative z-1 border border-text/40 bg-surface-canvas/70 px-3 py-2 font-mono text-caption font-medium tracking-[0.13em] text-text">
      {mediaLabel}
    </span>
  </div>
</article>
