---
import { DefinitionRow } from "@kufu/ui";

import SectionHeading from "../../common/SectionHeading.astro";
import { companyProfile } from "../../../content/company.js";

// API キー不要の埋め込み URL。住所からピンを立てる
const mapQuery = encodeURIComponent("兵庫県加古郡稲美町国安973番地の10");
const mapSrc = `https://maps.google.com/maps?q=${mapQuery}&z=16&hl=ja&output=embed`;
---

<section
  id="company"
  class="reveal-section border-b border-divider bg-surface-canvas"
  data-testid="home-section-company"
>
  <div class="mx-auto grid w-full max-w-360 gap-8 px-5 py-14 sm:px-8 md:gap-10 md:py-20 lg:px-14">
    <div class="grid gap-10">
      <SectionHeading
        number="03"
        eyebrow="COMPANY / 会社概要"
        title="会社概要"
      />
      <div class="grid gap-4 md:max-w-[38.75rem]">
        <p class="font-mono text-eyebrow font-medium tracking-[0.2em] text-primary">
          PHILOSOPHY / 経営理念
        </p>
        <p class="font-serif text-heading-28 font-semibold leading-[1.65] md:text-heading-36">
          <span class="text-primary">「創意」</span>と
          <span class="text-primary">「誠意」</span>で真心奉仕
        </p>
        <p class="whitespace-pre-line text-body leading-[1.75] text-text-secondary">
          {companyProfile.philosophyLead}
        </p>
      </div>
    </div>

    <div class="grid gap-10 lg:grid-cols-[30rem_1fr] lg:gap-14">
      <div class="grid content-start">
        <div class="pb-4">
          <p class="font-mono text-eyebrow font-medium tracking-[0.2em] text-primary">
            PROFILE / 基本情報
          </p>
          <h3 class="mt-2 font-serif text-heading-28 font-semibold leading-normal">
            基本情報
          </h3>
        </div>
        <div class="grid border-b border-divider">
          {
            companyProfile.rows.map(([label, value]) => (
              <DefinitionRow layout="compact" term={label}>
                {value}
              </DefinitionRow>
            ))
          }
        </div>
      </div>

      <div class="grid gap-9">
        <div class="grid gap-5 border-b border-divider pb-9">
          <div>
            <p class="font-mono text-eyebrow font-medium tracking-[0.2em] text-primary">
              MESSAGE / 代表挨拶
            </p>
            <h3 class="mt-2 font-serif text-heading-28 font-semibold leading-normal">
              ご挨拶
            </h3>
          </div>
          <div class="grid max-w-[40.5rem] gap-4 text-body leading-[1.75] text-text-secondary">
            {
              companyProfile.greeting.map((paragraph) => (
                <p>{paragraph.map((segment) =>
                  "emphasis" in segment && segment.emphasis ? (
                    <strong class="font-semibold text-text">{segment.text}</strong>
                  ) : (
                    segment.text
                  ),
                )}</p>
              ))
            }
          </div>
          <div class="flex items-center gap-4">
            <div class="grid size-24 place-items-center border border-divider bg-surface font-mono text-caption tracking-[0.16em] text-text-secondary">
              顔写真
            </div>
            <div class="grid gap-1.5">
              <p class="text-body font-semibold">福浦 崇志</p>
              <p class="text-caption tracking-[0.16em] text-text-secondary">
                代表取締役
              </p>
            </div>
          </div>
        </div>

        <div class="grid gap-5">
          <div>
            <p class="font-mono text-eyebrow font-medium tracking-[0.2em] text-primary">
              ACCESS / アクセス
            </p>
            <h3 class="mt-2 font-serif text-heading-28 font-semibold leading-normal">
              アクセス
            </h3>
          </div>
          <iframe
            title="有限会社フクウラ 所在地の地図"
            src={mapSrc}
            class="aspect-[16/10] w-full border border-divider"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            data-testid="company-access-map"
          ></iframe>
          <p class="text-body leading-7 text-text">{companyProfile.address}</p>
          <p class="font-mono text-caption leading-7 tracking-[0.12em] text-text-secondary">
            TEL 079-492-6465 ／ FAX 079-492-6429
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
