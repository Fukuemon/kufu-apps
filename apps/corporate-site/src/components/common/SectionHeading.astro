---
import { cva } from "@kufu/ui/lib";

export interface Props {
  number?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  level?: 1 | 2 | 3;
  align?: "start" | "center";
}

const {
  number,
  eyebrow,
  title,
  description,
  level = 2,
  align = "start",
} = Astro.props;
const HeadingTag = `h${level}` as const;

const sectionHeadingVariants = cva(
  "grid gap-4.5 w-[min(100%,53.75rem)] text-foreground",
  {
    variants: {
      align: {
        start: "",
        center: "justify-items-center mx-auto text-center",
      },
    },
    defaultVariants: {
      align: "start",
    },
  },
);
const rootClass = sectionHeadingVariants({ align });
---

<div class={rootClass}>
  {
    number || eyebrow ? (
      <div class="flex items-end gap-4.5">
        {number ? (
          <p class="font-mono text-[2.125rem] font-medium leading-[1.3] text-foreground">
            {number}
          </p>
        ) : null}
        {eyebrow ? (
          <p class="pb-1 font-mono text-[0.6875rem] font-medium leading-[1.45] tracking-[0.2em] text-primary">
            {eyebrow}
          </p>
        ) : null}
      </div>
    ) : null
  }
  <HeadingTag
    class="font-serif text-[clamp(2rem,5vw,2.625rem)] font-semibold leading-[1.45]"
  >
    {title}
  </HeadingTag>
  {
    description ? (
      <p class="max-w-180 whitespace-pre-line text-[0.9375rem] leading-[1.75] text-muted-foreground">
        {description}
      </p>
    ) : null
  }
</div>
