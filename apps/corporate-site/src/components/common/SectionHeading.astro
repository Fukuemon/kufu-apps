---
export interface Props {
  number?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  level?: 1 | 2 | 3;
  align?: "start" | "center";
}

const {
  number,
  eyebrow,
  title,
  description,
  level = 2,
  align = "start",
} = Astro.props;
const HeadingTag = `h${level}` as const;

const alignClass = {
  start: "",
  center: "justify-items-center mx-auto text-center",
};
---

<div
  class:list={[
    "grid gap-4.5 w-[min(100%,53.75rem)] text-text",
    alignClass[align],
  ]}
>
  {
    number || eyebrow ? (
      <div class="flex items-end gap-4.5">
        {number ? (
          <p class="font-mono text-heading-36 font-medium leading-[1.3] text-text">
            {number}
          </p>
        ) : null}
        {eyebrow ? (
          <p class="pb-1 font-sans text-caption font-medium text-primary">
            {eyebrow}
          </p>
        ) : null}
      </div>
    ) : null
  }
  <HeadingTag
    class="font-serif text-heading-32 md:text-heading-36 lg:text-heading-45 font-semibold leading-[1.45]"
  >
    {title}
  </HeadingTag>
  {
    description ? (
      <p class="max-w-180 whitespace-pre-line text-body leading-[1.75] text-text-secondary">
        {description}
      </p>
    ) : null
  }
</div>
