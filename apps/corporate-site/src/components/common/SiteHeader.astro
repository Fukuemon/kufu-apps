---
import { Image } from "astro:assets";

import fukuuraMark from "../../assets/fukuura-mark.png";

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) => currentPath === href;

const navItems = [
  { href: "/", label: "トップ", subLabel: "TOP", testId: "site-nav-home" },
  {
    href: "/#business",
    label: "事業内容",
    subLabel: "BUSINESS",
    testId: "site-nav-business",
  },
  {
    href: "/products",
    label: "取扱製品",
    subLabel: "PRODUCTS",
    testId: "site-nav-products",
  },
  {
    href: "/#company",
    label: "会社情報",
    subLabel: "COMPANY",
    testId: "site-nav-company",
  },
] as const;
---

<header
  class="site-header sticky top-0 z-20 bg-background/95 backdrop-blur"
  data-testid="site-header"
>
  <div
    class="mx-auto flex h-[4.1875rem] w-full max-w-360 items-center justify-between px-5 sm:px-8 md:h-24 lg:px-14"
  >
    <a class="flex items-center gap-3 text-foreground hover:text-primary" href="/">
      <Image
        src={fukuuraMark}
        alt=""
        width={34}
        height={29}
        loading="eager"
        class="h-7 w-auto"
      />
      <span class="grid gap-0.5">
        <span class="font-serif text-[1.0625rem] font-semibold leading-none md:text-xl">
          有限会社フクウラ
        </span>
        <span
          class="font-mono text-[0.625rem] font-medium tracking-[0.18em] text-primary"
        >
          FUKUURA
        </span>
      </span>
    </a>

    <button
      class="site-nav-toggle inline-flex size-11 items-center justify-center border border-border bg-card text-foreground md:hidden"
      type="button"
      aria-label="ナビゲーションを開く"
      aria-controls="site-nav-menu"
      aria-expanded="false"
      data-testid="site-nav-toggle"
    >
      <span class="site-nav-toggle-line" aria-hidden="true"></span>
      <span class="site-nav-toggle-line" aria-hidden="true"></span>
    </button>

    <nav
      id="site-nav-menu"
      class="site-nav-menu"
      aria-label="サイトナビゲーション"
      data-open="false"
      data-testid="site-nav-menu"
    >
      {
        navItems.map((item) => (
          <a
            class="site-nav-link"
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            data-testid={item.testId}
          >
            <span>{item.label}</span>
            <span class="site-nav-sub-label">{item.subLabel}</span>
          </a>
        ))
      }
      <a
        class="inline-flex min-h-10 items-center justify-center gap-2 bg-primary px-5 text-[0.8125rem] font-semibold text-kufu-white hover:opacity-90"
        href="/contact"
        data-contact-cta
        data-testid="site-nav-contact"
      >
        お問い合わせ
        <span class="font-mono text-xs" aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
  <div class="mx-auto h-px w-[calc(100%-2.5rem)] max-w-[83rem] bg-border sm:w-[calc(100%-4rem)] lg:w-[calc(100%-7rem)]" aria-hidden="true"></div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".site-nav-toggle");
  const menu = document.querySelector<HTMLElement>(".site-nav-menu");

  if (toggle && menu) {
    const close = () => {
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "ナビゲーションを開く");
      menu.dataset.open = "false";
    };

    const open = () => {
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "ナビゲーションを閉じる");
      menu.dataset.open = "true";
    };

    toggle.addEventListener("click", () => {
      if (toggle.getAttribute("aria-expanded") === "true") {
        close();
        return;
      }

      open();
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", close);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        close();
      }
    });
  }
</script>
