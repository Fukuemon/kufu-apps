---
import { companyProfile } from "../../content/company.js";
import { contactInfo } from "../../content/contact.js";
import { footerNav } from "../../content/navigation.js";
---

<footer
  class="surface-inverse bg-surface-canvas text-text"
  data-testid="site-footer"
>
  <div
    class="mx-auto grid w-full max-w-360 gap-10 px-5 py-12 sm:px-8 md:grid-cols-[1fr_1.2fr_1fr] md:py-16 lg:px-14"
  >
    <div class="grid gap-4">
      <p class="font-serif text-heading-24 font-semibold">{companyProfile.name}</p>
      <p class="font-serif text-heading-16 font-semibold leading-normal tracking-[0.0625rem] text-primary-soft">
        {companyProfile.philosophy}
      </p>
      <p class="max-w-75 text-caption leading-[1.9] text-text-inverse-secondary">
        {companyProfile.footerSummary}
      </p>
    </div>

    <nav class="grid gap-3" aria-label="フッターナビゲーション">
      {
        footerNav.items.map((item) => (
          <a class="focus-ring footer-link" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="grid gap-3">
      <p class="text-caption leading-7 text-text-inverse-secondary">
        {companyProfile.postalCode}
      </p>
      <p class="text-caption leading-7 text-text-inverse-secondary">
        {companyProfile.streetAddress}
      </p>
      <a class="focus-ring footer-link" href={contactInfo.telHref}>
        TEL {contactInfo.tel}
      </a>
      <p class="text-caption leading-7 text-text-inverse-secondary">FAX {contactInfo.fax}</p>
      <a class="focus-ring footer-link" href={contactInfo.emailHref}>
        {contactInfo.email}
      </a>
    </div>
  </div>
</footer>
