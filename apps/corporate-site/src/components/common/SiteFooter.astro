---
import { companyProfile } from "../../content/company.js";
import { contactInfo } from "../../content/contact.js";

export interface Props {
  variant?: "full" | "compact";
}

const { variant = "compact" } = Astro.props;
const isFull = variant === "full";
---

<footer
  class="surface-inverse bg-surface-canvas text-text"
  data-testid="site-footer"
>
  {
    !isFull ? (
      <div class="mx-auto grid w-full max-w-360 gap-6 px-5 py-7 sm:px-8 md:grid-cols-[1fr_auto] md:items-center lg:px-14">
        <div class="grid gap-1.5">
          <p class="font-serif text-heading-22 font-semibold">
            {companyProfile.name}
          </p>
          <p class="text-caption leading-normal text-kufu-gray-200">
            {companyProfile.tagline}
          </p>
        </div>
        <div class="grid gap-1.5 md:justify-items-end">
          <p class="font-mono text-caption tracking-[0.14em] text-kufu-gray-200">
            TEL {contactInfo.tel}
          </p>
          <p class="text-caption text-kufu-gray-200">
            {companyProfile.streetAddress}
          </p>
        </div>
      </div>
    ) : (
  <div
    class="mx-auto grid w-full max-w-360 gap-10 px-5 py-12 sm:px-8 md:grid-cols-[1fr_1.2fr_1fr] md:py-16 lg:px-14"
  >
    <div class="grid gap-4">
      <p class="font-serif text-heading-24 font-semibold">{companyProfile.name}</p>
      <p class="font-serif text-heading-16 font-semibold leading-normal tracking-[0.0625rem] text-primary-soft">
        {companyProfile.philosophy}
      </p>
      <p class="max-w-75 text-caption leading-[1.9] text-kufu-gray-200">
        機械工具と関連機器の販売、各種別作加工、小規模工事。兵庫県加古郡稲美町より、製造現場の調達と加工、設備の工事を支えます。
      </p>
    </div>

    <nav class="grid gap-3" aria-label="フッターナビゲーション">
      <p class="font-mono text-eyebrow font-normal tracking-[0.18em] text-kufu-gray-500">
        SITEMAP
      </p>
      <a class="footer-link" href="/#business">
        事業内容
      </a>
      <a class="footer-link" href="/products">
        取扱製品
      </a>
      <a class="footer-link" href="/#company">
        会社概要
      </a>
      <a class="footer-link" href="/contact">
        お問い合わせ・お見積り
      </a>
    </nav>

    <div class="grid gap-3">
      <p class="font-mono text-eyebrow font-normal tracking-[0.18em] text-kufu-gray-500">
        CONTACT
      </p>
      <p class="text-caption leading-7 text-kufu-gray-200">
        {companyProfile.postalCode}
      </p>
      <p class="text-caption leading-7 text-kufu-gray-200">
        {companyProfile.streetAddress}
      </p>
      <a class="footer-link" href={`tel:${contactInfo.tel.replaceAll("-", "")}`}>
        TEL {contactInfo.tel}
      </a>
      <p class="text-caption leading-7 text-kufu-gray-200">FAX {contactInfo.fax}</p>
      <a class="footer-link" href={`mailto:${contactInfo.email}`}>
        {contactInfo.email}
      </a>
    </div>
  </div>
    )
  }
</footer>
