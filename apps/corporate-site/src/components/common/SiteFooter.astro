---
import { companyProfile } from "../../content/company.js";
import { contactInfo } from "../../content/contact.js";

export interface Props {
  variant?: "full" | "compact";
}

const { variant = "compact" } = Astro.props;
const isFull = variant === "full";
---

<footer
  class="surface-inverse border-t border-border bg-background text-foreground"
  data-testid="site-footer"
>
  <div
    class:list={[
      "mx-auto grid w-full max-w-360 gap-10 px-5 py-12 sm:px-8 lg:px-14",
      isFull ? "md:grid-cols-[1fr_1.2fr_1fr]" : "md:grid-cols-[1fr_1fr]",
    ]}
  >
    <div class="grid gap-4">
      <p class="font-serif text-2xl font-semibold">{companyProfile.name}</p>
      <p class="max-w-95 text-sm leading-7 text-secondary-foreground">
        {companyProfile.philosophy}
      </p>
    </div>

    {
      isFull ? (
        <nav class="grid gap-3" aria-label="フッターナビゲーション">
          <p class="font-mono text-xs font-medium tracking-[0.18em] text-primary-soft">
            SITE MAP
          </p>
          <a class="footer-link" href="/">
            トップ
          </a>
          <a class="footer-link" href="/#business">
            事業内容
          </a>
          <a class="footer-link" href="/products">
            取扱製品
          </a>
          <a class="footer-link" href="/#company">
            会社情報
          </a>
          <a class="footer-link" href="/contact">
            お問い合わせ
          </a>
        </nav>
      ) : null
    }

    <div class="grid gap-3">
      <p class="font-mono text-xs font-medium tracking-[0.18em] text-primary-soft">
        CONTACT
      </p>
      <p class="text-sm leading-7 text-secondary-foreground">
        {companyProfile.address}
      </p>
      <a class="footer-link" href={`tel:${contactInfo.tel.replaceAll("-", "")}`}>
        TEL {contactInfo.tel}
      </a>
      <p class="text-sm leading-7 text-secondary-foreground">FAX {contactInfo.fax}</p>
      <a class="footer-link" href={`mailto:${contactInfo.email}`}>
        {contactInfo.email}
      </a>
    </div>
  </div>
</footer>
