---
export interface Props {
  number?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  level?: 1 | 2 | 3;
  align?: "start" | "center";
}

const {
  number,
  eyebrow,
  title,
  description,
  level = 2,
  align = "start",
} = Astro.props;
const HeadingTag = `h${level}` as const;
---

<div class="section-heading" data-align={align}>
  {
    number || eyebrow ? (
      <div class="section-heading__meta">
        {number ? <p class="section-heading__number">{number}</p> : null}
        {eyebrow ? <p class="section-heading__eyebrow">{eyebrow}</p> : null}
      </div>
    ) : null
  }
  <HeadingTag class="section-heading__title">{title}</HeadingTag>
  {description ? <p class="section-heading__description">{description}</p> : null}
</div>

<style>
  .section-heading {
    display: grid;
    gap: 1.125rem;
    inline-size: min(100%, 47.5rem);
    color: var(--foreground);
  }

  .section-heading[data-align="center"] {
    justify-items: center;
    margin-inline: auto;
    text-align: center;
  }

  .section-heading__meta {
    display: flex;
    align-items: end;
    gap: 1.125rem;
  }

  .section-heading__number,
  .section-heading__eyebrow,
  .section-heading__title,
  .section-heading__description {
    margin: 0;
  }

  .section-heading__number {
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: 2.125rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .section-heading__eyebrow {
    padding-block-end: 0.25rem;
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: 0.2em;
  }

  .section-heading__title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 2.625rem);
    font-weight: 600;
    line-height: 1.45;
  }

  .section-heading__description {
    max-inline-size: 38.75rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.75;
  }
</style>
