---
import { LinkButton } from "@kufu/ui";

export interface Props {
  href: string;
  size?: "sm" | "hero" | "lg";
  "data-testid"?: string;
}

const { href, size = "lg", "data-testid": testId } = Astro.props;

const linkButtonSize = {
  sm: "cta-sm",
  hero: "cta-hero",
  lg: "cta-lg",
} as const;
---

<LinkButton
  href={href}
  variant="cta"
  size={linkButtonSize[size]}
  data-testid={testId}
>
  <slot />
</LinkButton>
