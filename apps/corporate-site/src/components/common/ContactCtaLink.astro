---
import { LinkButton } from "@kufu/ui";

export interface Props {
  href: string;
  size?: "sm" | "hero" | "lg";
  "data-testid"?: string;
}

const { href, size = "lg", "data-testid": testId } = Astro.props;

// 各 CTA の外形寸法。色/hover は全サイズ共通のため sizeClassName の外で固定する
const sizeClassName = {
  sm: "min-h-10 gap-2 px-5 text-[0.8125rem] font-semibold",
  hero: "min-h-[3.375rem] gap-0 border-primary px-6 text-[0.9375rem] font-medium",
  lg: "min-h-13 gap-3 px-6 text-[0.9375rem] font-semibold",
}[size];
---

<LinkButton
  href={href}
  className={`h-auto bg-primary hover:bg-primary hover:opacity-90 ${sizeClassName}`}
  data-contact-cta
  data-testid={testId}
>
  <slot />
</LinkButton>
