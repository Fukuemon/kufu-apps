---
import SectionHeading from "../../common/SectionHeading.astro";
import { companyProfile } from "../../../content/company.js";

// API キー不要の埋め込み URL。住所からピンを立てる
const mapQuery = encodeURIComponent("兵庫県加古郡稲美町国安973番地の10");
const mapSrc = `https://maps.google.com/maps?q=${mapQuery}&z=16&hl=ja&output=embed`;
---

<section
  id="company"
  class="reveal-section border-b border-border bg-background"
  data-testid="home-section-company"
>
  <div class="mx-auto grid w-full max-w-360 gap-8 px-5 py-14 sm:px-8 md:gap-10 md:py-20 lg:px-14">
    <div class="grid gap-10">
      <SectionHeading
        number="03"
        eyebrow="COMPANY / 会社概要"
        title="会社概要"
      />
      <div class="grid gap-4 md:max-w-[38.75rem]">
        <p class="font-mono text-[0.6875rem] font-medium tracking-[0.2em] text-primary">
          PHILOSOPHY / 経営理念
        </p>
        <p class="font-serif text-[1.75rem] font-semibold leading-[1.65] md:text-[2.25rem]">
          <span class="text-primary">「創意」</span>と
          <span class="text-primary">「誠意」</span>で真心奉仕
        </p>
        <p class="whitespace-pre-line text-[0.9375rem] leading-[1.75] text-muted-foreground">
          {companyProfile.philosophyLead}
        </p>
      </div>
    </div>

    <div class="grid gap-10 lg:grid-cols-[30rem_1fr] lg:gap-14">
      <div class="grid content-start">
        <div class="pb-4">
          <p class="font-mono text-[0.6875rem] font-medium tracking-[0.2em] text-primary">
            PROFILE / 基本情報
          </p>
          <h3 class="mt-2 font-serif text-[1.75rem] font-semibold leading-normal">
            基本情報
          </h3>
        </div>
        <div class="grid border-b border-border">
          {
            companyProfile.rows.map(([label, value]) => (
              <div class="grid gap-3 border-t border-border py-3.5 md:grid-cols-[6.5rem_1fr] md:gap-5">
                <p class="font-mono text-[0.6875rem] font-normal leading-6 tracking-[0.12em] text-muted-foreground">
                  {label}
                </p>
                <p class="text-sm leading-6 text-foreground">{value}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="grid gap-9">
        <div class="grid gap-5 border-b border-border pb-9">
          <div>
            <p class="font-mono text-[0.6875rem] font-medium tracking-[0.2em] text-primary">
              MESSAGE / 代表挨拶
            </p>
            <h3 class="mt-2 font-serif text-[1.75rem] font-semibold leading-normal">
              ご挨拶
            </h3>
          </div>
          <p class="max-w-[40.5rem] whitespace-pre-line text-[0.9375rem] leading-[1.75] text-muted-foreground">
            {companyProfile.greeting}
          </p>
          <div class="flex items-center gap-4">
            <div class="grid size-24 place-items-center border border-border bg-card font-mono text-[0.6875rem] tracking-[0.16em] text-muted-foreground">
              顔写真
            </div>
            <div class="grid gap-1.5">
              <p class="text-sm font-semibold">福浦 崇志</p>
              <p class="text-[0.71875rem] tracking-[0.16em] text-muted-foreground">
                代表取締役
              </p>
            </div>
          </div>
        </div>

        <div class="grid gap-5">
          <div>
            <p class="font-mono text-[0.6875rem] font-medium tracking-[0.2em] text-primary">
              ACCESS / アクセス
            </p>
            <h3 class="mt-2 font-serif text-[1.75rem] font-semibold leading-normal">
              アクセス
            </h3>
          </div>
          <iframe
            title="有限会社フクウラ 所在地の地図"
            src={mapSrc}
            class="aspect-[16/10] w-full border border-border"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            data-testid="company-access-map"
          ></iframe>
          <p class="text-sm leading-7 text-foreground">{companyProfile.address}</p>
          <p class="font-mono text-xs leading-7 tracking-[0.12em] text-muted-foreground">
            TEL 079-492-6465 ／ FAX 079-492-6429
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
