---
import SectionHeading from "../../common/SectionHeading.astro";
import { consultationContent } from "../../../content/consultation.js";
---

<section
  id="consultation"
  class="consultation-industrial reveal-section border-b border-border bg-card"
  data-testid="home-section-consultation"
>
  <div class="mx-auto grid w-full max-w-360 gap-10 px-5 py-14 sm:px-8 md:gap-12 md:py-18 lg:px-14">
    <SectionHeading
      number={consultationContent.heading.number}
      eyebrow={consultationContent.heading.eyebrow}
      title={consultationContent.heading.title}
      description={consultationContent.heading.description}
    />

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_25rem] lg:items-start lg:gap-12">
      <div class="grid border border-border bg-background">
        {
          consultationContent.cases.map((item, index) => (
            <article class="consultation-case grid gap-4 border-b border-border px-5 py-5 last:border-b-0 md:grid-cols-[4rem_1fr] md:items-start md:gap-6 md:px-6">
              <p class="font-mono text-[0.75rem] font-medium tracking-[0.18em] text-primary">
                {String(index + 1).padStart(2, "0")}
              </p>
              <div class="grid gap-2">
                <p class="font-serif text-[1.0625rem] font-semibold leading-[1.55]">
                  {item.title}
                </p>
                <p class="max-w-170 text-[0.875rem] leading-[1.8] text-muted-foreground">
                  {item.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>

      <aside class="flow-panel grid border border-border bg-muted">
        <div class="border-b border-border px-5 py-5 md:px-6">
          <h3 class="font-serif text-[1.5rem] font-semibold leading-normal">
            相談から納品まで
          </h3>
        </div>
        <ol class="grid list-none px-5 py-2 md:px-6">
          {
            consultationContent.flow.map((item) => (
              <li class="grid grid-cols-[3.25rem_1fr] gap-4 border-b border-border py-5 last:border-b-0">
                <p class="font-mono text-[0.75rem] font-medium tracking-[0.18em] text-primary">
                  {item.step}
                </p>
                <div class="grid gap-1.5">
                  <p class="font-serif text-[1rem] font-semibold leading-normal">
                    {item.title}
                  </p>
                  <p class="text-[0.8125rem] leading-[1.75] text-muted-foreground">
                    {item.description}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
  </div>
</section>
