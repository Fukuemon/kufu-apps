---
export interface Props {
  number: string;
  title: string;
  lead: string;
}

const { number, title, lead } = Astro.props;
---

<article class="flex flex-col gap-2 w-full py-4 text-foreground">
  <div class="h-px w-full bg-border" aria-hidden="true"></div>
  <header class="flex items-center gap-4">
    <p
      class="font-mono text-[0.625rem] font-medium leading-none tracking-[0.2em] text-primary"
    >
      {number}
    </p>
    <h3 class="font-serif text-base font-semibold leading-normal">{title}</h3>
  </header>
  <p class="text-[0.84375rem] leading-[1.7] text-muted-foreground">{lead}</p>
</article>
