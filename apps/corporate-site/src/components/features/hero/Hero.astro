---
import { Image } from "astro:assets";

import heroImage from "../../../assets/corporate-hero-industrial.png";
import { heroContent } from "../../../content/hero.js";
import { servicePillars } from "../../../content/services.js";
---

<section
  class="hero-industrial relative overflow-hidden bg-background"
  data-testid="home-section-hero"
>
  <div
    class="relative z-1 mx-auto grid w-full max-w-360 gap-6 px-5 pb-16 pt-10 sm:px-8 md:min-h-[46.75rem] md:grid-cols-[minmax(0,43.75rem)_minmax(24rem,36.25rem)] md:items-start md:gap-12 md:pb-24 md:pt-14 lg:px-14 xl:gap-12"
  >
    <div class="hero-copy grid gap-6 md:col-start-1 md:row-start-1 md:pt-6 lg:pt-20">
      <p class="font-mono text-[0.6875rem] font-medium leading-none tracking-[0.22em] text-primary">
        {heroContent.eyebrow}
      </p>
      <h1 class="font-serif text-[2.5rem] font-semibold leading-[1.18] md:text-[4rem] md:leading-[1.16]">
        <span class="block">機械工具の調達と、</span>
        <span class="block">特注加工を一社で。</span>
      </h1>
      <p class="max-w-[41.6875rem] text-[0.9375rem] leading-[1.95] text-muted-foreground md:text-base">
        {heroContent.lead.split("\n").map((line) => (
          <>
            {line}
            <br />
          </>
        ))}
      </p>
    </div>

    <div class="hero-media relative min-h-[18.75rem] overflow-hidden bg-kufu-gray-800 md:col-start-2 md:row-span-3 md:row-start-1 md:min-h-[38.75rem]">
      <Image
        src={heroImage}
        alt="工場設備と加工相談のイメージ"
        width={860}
        height={459}
        widths={[430, 860, 1290]}
        sizes="(min-width: 768px) 50vw, 100vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="hero-media-overlay absolute inset-0 bg-photo-overlay" aria-hidden="true"></div>
      <div class="hero-media-ruler" aria-hidden="true"></div>
      <p
        class="hero-media-caption absolute bottom-7 left-7 z-1 bg-card-overlay px-4 py-3 font-mono text-[0.6875rem] font-medium leading-5 tracking-[0.16em] text-foreground"
      >
        <span class="text-foreground">機械工具・関連機器の調達</span><br />
        <span class="text-muted-foreground">別作加工 / 樹脂 / 板金溶接 / ゴム加工</span>
      </p>
    </div>

    <div class="grid max-w-[38.75rem] md:col-start-1 md:row-start-2">
      {
        servicePillars.map((pillar) => (
          <div class="border-t border-border py-4">
            <div class="grid gap-2 sm:grid-cols-[4.5rem_1fr] sm:gap-4">
              <p class="font-mono text-[0.6875rem] font-medium tracking-[0.18em] text-primary">
                {pillar.number}
              </p>
              <div class="grid gap-2">
                <p class="font-serif text-base font-semibold leading-normal">
                  {pillar.title}
                </p>
                <p class="text-[0.84375rem] leading-[1.7] text-muted-foreground">
                  {pillar.lead}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="flex flex-col gap-4 pt-1 sm:flex-row sm:items-center md:col-start-1 md:row-start-3">
      <a
        class="inline-flex min-h-[3.375rem] items-center justify-center border border-primary bg-primary px-6 text-[0.9375rem] font-medium text-kufu-white hover:opacity-90"
        href={heroContent.primaryCta.href}
        data-contact-cta
        data-testid="home-link-contact"
      >
        {heroContent.primaryCta.label}
        <span class="ml-3 font-mono" aria-hidden="true">→</span>
      </a>
      <a
        class="inline-flex min-h-9 items-center text-[0.9375rem] font-medium text-foreground underline decoration-border underline-offset-8 hover:text-primary"
        href={heroContent.secondaryCta.href}
      >
        {heroContent.secondaryCta.label}
      </a>
    </div>

    <a
      class="scroll-cue hidden items-center gap-3 justify-self-end font-mono text-[0.625rem] font-medium tracking-[0.2em] text-muted-foreground transition hover:text-primary md:col-start-2 md:row-start-3 md:flex"
      href="#consultation"
      aria-label="相談内容セクションへスクロール"
    >
      <span>SCROLL</span>
      <span class="scroll-cue-icon grid size-9 place-items-center border border-border text-primary" aria-hidden="true">
        ↓
      </span>
    </a>
  </div>
</section>
