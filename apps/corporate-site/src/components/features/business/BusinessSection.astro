---
import SectionHeading from "../../common/SectionHeading.astro";
import BusinessFeatureRow from "./BusinessFeatureRow.astro";
import machiningImage from "../../../assets/corporate-machining-service.png";
import supplyImage from "../../../assets/corporate-products-supply.png";
import { businessContent } from "../../../content/business.js";

const featureImages = [supplyImage, machiningImage] as const;
---

<section
  id="business"
  class="border-b border-border bg-card"
  data-testid="home-section-business"
>
  <div class="mx-auto grid w-full max-w-360 gap-16 px-5 py-14 sm:px-8 md:gap-20 md:py-20 lg:px-14">
    <SectionHeading
      number={businessContent.heading.number}
      eyebrow={businessContent.heading.eyebrow}
      title={businessContent.heading.title}
      description={businessContent.heading.description}
    />

    <div class="grid">
      {
        businessContent.features.map((feature, index) => (
          <BusinessFeatureRow
            number={feature.number}
            eyebrow={feature.eyebrow}
            title={feature.title}
            description={feature.description}
            items={[...feature.items]}
            mediaLabel={feature.mediaLabel}
            mediaCaption={feature.mediaCaption}
            mediaPosition={feature.mediaPosition}
            image={featureImages[index]}
            imageLoading="eager"
          />
        ))
      }
    </div>

    <div class="grid border border-border bg-card md:grid-cols-[13.125rem_1fr]">
      <div class="border-b border-border px-5 py-5 md:border-b-0 md:border-r md:px-7 md:py-6">
        <p class="font-mono text-[0.6875rem] font-medium tracking-[0.2em] text-primary">
          {businessContent.customOrder.eyebrow}
        </p>
        <p class="mt-2 font-serif text-xl font-semibold leading-normal">
          {businessContent.customOrder.title}
        </p>
      </div>
      <div class="grid gap-x-7 gap-y-3 px-5 py-6 md:grid-cols-3 md:px-7">
        {
          businessContent.customOrder.items.map((item) => (
            <div class="flex items-center gap-2.5">
              <span class="h-0.5 w-3.5 bg-primary" aria-hidden="true"></span>
              <p class="min-w-0 text-[0.8125rem] leading-normal text-foreground">
                {item}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
