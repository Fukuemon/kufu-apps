---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  number?: string;
  eyebrow: string;
  title: string;
  description: string;
  items: string[];
  mediaLabel: string;
  mediaCaption: string;
  mediaPosition: "left" | "right";
  image?: ImageMetadata;
  imageLoading?: "eager" | "lazy";
}

const {
  number,
  eyebrow,
  title,
  description,
  items,
  mediaLabel,
  mediaCaption,
  mediaPosition,
  image,
  imageLoading = "lazy",
} = Astro.props;
const mediaClass = [
  "relative flex items-end min-h-95 overflow-hidden p-5 border border-border bg-kufu-gray-800 min-[760px]:flex-[1_1_auto]",
  mediaPosition === "left" ? "min-[760px]:order-[-1]" : "",
].join(" ");
---

<article
  class="flex flex-col gap-6 w-full py-11 text-foreground min-[760px]:flex-row min-[760px]:items-center min-[760px]:gap-14"
>
  <div
    class="relative flex flex-col gap-4 min-[760px]:flex-[0_0_30rem] min-[760px]:w-120"
  >
    {
      number ? (
        <span
          class="absolute -top-8.5 -left-2.5 font-mono text-[8.75rem] font-medium leading-none text-ghost-foreground pointer-events-none z-0"
          aria-hidden="true"
        >
          {number}
        </span>
      ) : null
    }
    <p
      class="relative z-1 text-primary font-mono text-xs font-normal leading-[1.4] tracking-[0.16em]"
    >
      {eyebrow}
    </p>
    <h3
      class="relative z-1 font-serif text-[1.875rem] font-semibold leading-[1.45]"
    >
      {title}
    </h3>
    <p
      class="relative z-1 text-muted-foreground text-[0.9375rem] leading-[1.75]"
    >
      {description}
    </p>
    <ul class="relative z-1 flex flex-wrap gap-2 pt-1.5 list-none">
      {
        items.map((item) => (
          <li class="px-3 py-1.5 rounded-[4px] bg-secondary text-foreground text-[0.78125rem] leading-[1.4]">
            {item}
          </li>
        ))
      }
    </ul>
  </div>
  <div class={mediaClass}>
    {
      image ? (
        <Image
          src={image}
          alt={mediaCaption}
          width={768}
          height={512}
          loading={imageLoading}
          class="absolute inset-0 h-full w-full object-cover"
        />
      ) : null
    }
    <div class="absolute inset-0 bg-photo-overlay" aria-hidden="true"></div>
    <span class="relative z-1 font-mono text-xs font-medium tracking-[0.13em] text-kufu-white">
      {mediaLabel}
    </span>
  </div>
</article>
