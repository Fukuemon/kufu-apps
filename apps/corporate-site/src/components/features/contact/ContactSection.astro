---
import { companyProfile } from "../../../content/company.js";
import { contactInfo } from "../../../content/contact.js";
import ContactInfoRow from "./ContactInfoRow.astro";
---

<section class="bg-background">
  <div class="mx-auto grid w-full max-w-360 gap-10 px-5 py-20 sm:px-8 lg:px-14">
    <div class="grid gap-5">
      <p class="font-mono text-xs font-medium tracking-[0.18em] text-primary">
        CONTACT
      </p>
      <h1 class="font-serif text-4xl font-semibold leading-tight md:text-6xl">
        お問い合わせ
      </h1>
      <p class="max-w-180 text-base leading-8 text-muted-foreground">
        お見積もり、取扱製品、加工のご相談は、電話・FAX・メールでお問い合わせください。
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <section
        class="grid gap-6 border border-border bg-card p-6 md:p-8"
        data-testid="contact-section-info"
      >
        <div class="grid gap-2">
          <h2 class="font-serif text-2xl font-semibold">連絡先</h2>
          <p class="text-sm leading-7 text-muted-foreground">
            {companyProfile.address}
          </p>
        </div>
        <div class="grid gap-5">
          {
            contactInfo.rows.map((row) => (
              <ContactInfoRow
                label={row.label}
                value={row.value}
                href={"href" in row ? row.href : undefined}
              />
            ))
          }
        </div>
      </section>

      <section
        class="grid content-center gap-4 border border-dashed border-border bg-muted p-6 md:p-8"
        data-testid="contact-form-slot"
        aria-label="問い合わせフォーム実装境界"
      >
        <p class="font-mono text-xs font-medium tracking-[0.18em] text-primary">
          FORM SLOT
        </p>
        <h2 class="font-serif text-2xl font-semibold">
          問い合わせフォーム領域
        </h2>
        <p class="text-sm leading-7 text-muted-foreground">
          フォーム本体は後続の実装で差し込みます。現時点では電話・FAX・メールで接点を確保します。
        </p>
      </section>
    </div>
  </div>
</section>
