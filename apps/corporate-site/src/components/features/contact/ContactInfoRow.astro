---
export interface Props {
  label: string;
  value: string;
  href?: string;
}

const { label, value, href } = Astro.props;
---

<div class="flex flex-col gap-1.5 w-full text-foreground">
  <p
    class="font-mono text-[0.6875rem] font-normal leading-[1.4] tracking-[0.145em] text-primary"
  >
    {label}
  </p>
  <p class="text-[0.9375rem] leading-[1.7]">
    {
      href ? (
        <a
          class="text-foreground underline decoration-primary decoration-1 underline-offset-[0.25em] hover:text-primary"
          href={href}
        >
          {value}
        </a>
      ) : (
        value
      )
    }
  </p>
</div>
