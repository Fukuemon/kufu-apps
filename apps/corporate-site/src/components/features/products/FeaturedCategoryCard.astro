---
export interface Props {
  category: string;
  count?: string;
  title: string;
  image?: string;
}

const { category, count, title, image } = Astro.props;
---

<article
  class="flex flex-col w-65 overflow-hidden border border-border bg-card text-card-foreground"
>
  <div
    class="h-37.5 bg-muted bg-center bg-cover"
    style={image ? `background-image: url(${image})` : undefined}
  >
  </div>
  <div class="flex flex-col gap-2 px-4 pt-3.5 pb-4">
    {/* count の有無でフォントサイズ差による行高ずれが出ないよう leading-4 固定 */}
    <div class="flex items-center justify-between leading-4">
      <p
        class="font-mono text-[0.6875rem] font-medium tracking-[0.09em] text-primary"
      >
        {category}
      </p>
      {
        count ? (
          <p class="text-[0.71875rem] text-muted-foreground">{count}</p>
        ) : null
      }
    </div>
    <p class="text-[0.9375rem] font-semibold leading-normal text-foreground">
      {title}
    </p>
  </div>
</article>
