---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import productsImage from "../../../assets/corporate-products-supply.png";

const productCategories = (await getCollection("productCategories")).sort(
  (a, b) => a.data.order - b.data.order,
);
const categoryMakers = (await getCollection("categoryMakers")).sort(
  (a, b) => a.data.order - b.data.order,
);

const makersByCategory = new Map(
  categoryMakers.map((entry) => [entry.data.categoryId, entry]),
);

const categoriesWithMakers = productCategories.map((category) => {
  const makers = makersByCategory.get(category.id);

  if (!makers) {
    throw new Error(`Missing makers for product category: ${category.id}`);
  }

  return {
    category,
    makers,
  };
});

const makerCountById = new Map(
  categoryMakers.map((entry) => [entry.data.categoryId, entry.data.makers.length]),
);

// 索引ナビは18カテゴリを3列に等分する
const indexColumns = [
  productCategories.slice(0, 6),
  productCategories.slice(6, 12),
  productCategories.slice(12, 18),
];

// design: Products Category List はカテゴリを4グループの見出しで束ねる
const categoryGroups = [
  { eyebrow: "CATEGORY 01–05", title: "駆動・伝動", from: 1, to: 5 },
  { eyebrow: "CATEGORY 06–08", title: "流体・配管", from: 6, to: 8 },
  { eyebrow: "CATEGORY 09–11", title: "搬送・工場設備", from: 9, to: 11 },
  { eyebrow: "CATEGORY 12–18", title: "工具・測定・材料", from: 12, to: 18 },
].map((group) => ({
  ...group,
  items: categoriesWithMakers.filter(
    ({ category }) =>
      category.data.order >= group.from && category.data.order <= group.to,
  ),
}));
---

<section class="bg-background">
  <div class="mx-auto grid w-full max-w-360 gap-10 px-5 py-12 sm:px-8 md:gap-16 md:py-16 lg:px-14">
    <div class="grid gap-10 lg:grid-cols-[38.125rem_1fr] lg:items-center">
      <div class="reveal-section grid gap-5">
        <nav class="flex gap-2 font-mono text-[0.6875rem] tracking-[0.12em] text-muted-foreground" aria-label="パンくず">
          <a href="/">トップ</a>
          <span>/</span>
          <span class="text-primary">取扱製品</span>
        </nav>
        <p class="font-mono text-xs font-medium tracking-[0.22em] text-primary">
          PRODUCTS &amp; MAKERS
        </p>
        <h1 class="max-w-152 font-serif text-[2.5rem] font-semibold leading-[1.22] md:text-5xl">
          製造現場に必要な製品を、確かなメーカー網で。
        </h1>
        <p class="max-w-148 text-base leading-[1.85] text-muted-foreground">
          駆動・伝動、空圧・油圧、工具、測定、搬送、工場設備まで。全18カテゴリ・延べ約320社の取扱メーカーから、製品の選定と調達に応えます。
        </p>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
          <a
            class="inline-flex min-h-13 items-center justify-center gap-3 bg-primary px-6 text-[0.9375rem] font-semibold text-kufu-white hover:opacity-90"
            href="/contact"
            data-contact-cta
            data-testid="products-link-contact"
          >
            製品について相談する
            <span class="font-mono text-xs" aria-hidden="true">→</span>
          </a>
          <a class="text-[0.9375rem] font-medium" href="#products-category-list">
            カテゴリ一覧を見る
          </a>
        </div>
      </div>
      <div class="reveal-section relative min-h-[26.25rem] overflow-hidden border border-border bg-kufu-gray-800">
        <Image
          src={productsImage}
          alt="機械工具・関連機器"
          width={784}
          height={502}
          loading="eager"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-photo-overlay" aria-hidden="true"></div>
        <div class="absolute bottom-6 left-6 bg-card-overlay px-4 py-3">
          <p class="text-sm font-semibold">機械工具・関連機器</p>
          <p class="mt-1 font-mono text-[0.6875rem] tracking-[0.1em] text-muted-foreground">
            駆動・伝動 / 工具・測定 / 搬送 / 工場設備
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-muted" data-testid="products-section-index">
  <div class="mx-auto grid w-full max-w-360 gap-8 px-5 py-14 sm:px-8 md:gap-10 md:py-20 lg:px-14">
    <div class="grid gap-4">
      <p class="font-mono text-[0.6875rem] font-medium tracking-[0.22em] text-primary">
        CATEGORY INDEX
      </p>
      <h2 class="font-serif text-[2rem] font-semibold leading-[1.45] md:text-[2.625rem]">
        取扱製品カテゴリ
      </h2>
      <p class="max-w-180 text-[0.9375rem] leading-[1.75] text-muted-foreground">
        製造現場の調達で相談が多い領域を18のカテゴリに整理し、各カテゴリの取扱メーカーを一覧にまとめています。
      </p>
    </div>

    <nav
      id="products-category-list"
      class="reveal-section grid scroll-mt-24 gap-4 border border-border bg-card p-5 md:p-7"
      aria-label="取扱製品カテゴリ索引"
      data-testid="products-category-list"
      data-category-nav
    >
      <p class="font-mono text-[0.625rem] font-medium tracking-[0.2em] text-muted-foreground">
        INDEX
      </p>
      <div class="grid gap-x-10 md:grid-cols-3">
        {
          indexColumns.map((column) => (
            <div class="grid border-b border-border">
              {column.map((category) => (
                <a
                  class="products-nav-link grid grid-cols-[2.5rem_1fr_auto] items-center gap-3 border-t border-border py-2.5 hover:text-primary"
                  href={`#${category.id}`}
                  data-nav-target={category.id}
                >
                  <span class="font-mono text-[0.6875rem] font-medium tracking-[0.08em] text-primary">
                    {String(category.data.order).padStart(2, "0")}
                  </span>
                  <span class="text-sm font-medium leading-normal">
                    {category.data.name}
                  </span>
                  <span class="text-[0.71875rem] text-muted-foreground">
                    {makerCountById.get(category.id) ?? 0}社
                  </span>
                </a>
              ))}
            </div>
          ))
        }
      </div>
    </nav>

    <div
      class="products-toolbar reveal-section grid gap-4 border border-border bg-card p-5 md:flex md:items-center md:justify-between md:gap-6 md:px-7"
      data-products-toolbar
    >
      <label class="grid gap-2 md:min-w-80 md:flex-1">
        <span class="sr-only">カテゴリ・メーカー名で検索</span>
        <span class="relative block">
          <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 font-mono text-base text-muted-foreground" aria-hidden="true">⌕</span>
          <input
            type="search"
            class="min-h-12 w-full border border-border bg-background pl-9 pr-3 text-sm"
            placeholder="カテゴリ名・メーカー名で検索"
            aria-controls="products-category-groups"
            data-products-search
          />
        </span>
      </label>
      <div class="flex items-center justify-between gap-4 md:justify-end">
        <p class="text-[0.8125rem] text-muted-foreground" data-products-result aria-live="polite" hidden></p>
        <div class="flex gap-2">
          <button type="button" class="products-control-btn" data-expand-all>すべて開く</button>
          <button type="button" class="products-control-btn" data-collapse-all>すべて閉じる</button>
        </div>
      </div>
    </div>

    <div
      id="products-category-groups"
      class="border border-border bg-card p-5 md:px-10 md:py-8"
    >
      <p class="hidden text-sm leading-[1.8] text-muted-foreground" data-products-empty>
        該当するカテゴリ・メーカーが見つかりませんでした。検索条件を変えてお試しください。
      </p>
      {
        categoryGroups.map((group) => (
          <div class="products-group mt-11 grid first:mt-0" data-products-group>
            <div class="grid gap-2 pb-1" data-group-heading>
              <p class="font-mono text-[0.6875rem] font-medium tracking-[0.18em] text-primary">
                {group.eyebrow}
              </p>
              <h3 class="font-serif text-2xl font-semibold leading-normal text-foreground md:text-[1.625rem]">
                {group.title}
              </h3>
            </div>
            {group.items.map(({ category, makers }) => (
              <article
                id={category.id}
                class="reveal-section grid scroll-mt-28 border-t border-border"
                data-testid={`products-category-${category.id}`}
                data-category-item
                data-category-name={category.data.name}
              >
                <details class="products-accordion" open>
                  <summary class="products-accordion-summary grid cursor-pointer grid-cols-[2.75rem_1fr_auto] items-center gap-3 py-5 md:gap-5 md:py-6">
                    <span class="font-mono text-[0.8125rem] font-medium tracking-[0.08em] text-primary">
                      {String(category.data.order).padStart(2, "0")}
                    </span>
                    <span class="grid gap-1">
                      <span class="font-serif text-xl font-semibold leading-[1.35] text-foreground">
                        {category.data.name}
                      </span>
                      <span class="text-xs font-medium text-primary">
                        取扱メーカー {makers.data.makers.length}社
                      </span>
                    </span>
                    <span class="products-accordion-icon inline-flex size-7 items-center justify-center border border-border font-mono text-base text-muted-foreground" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <div class="pb-6 pl-14 md:pb-7 md:pl-16">
                    <ul
                      class="columns-1 gap-7 sm:columns-2 lg:columns-3 list-none"
                      data-testid={`products-maker-list-${category.id}`}
                      data-maker-list
                    >
                      {makers.data.makers.map((maker) => (
                        <li
                          class="break-inside-avoid text-[0.8125rem] leading-[1.95] text-muted-foreground"
                          data-maker={maker}
                        >
                          {maker}
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              </article>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <button
    type="button"
    class="products-backtop"
    data-products-backtop
    aria-label="カテゴリ一覧の先頭へ戻る"
    hidden
  >
    <span class="font-mono text-base leading-none" aria-hidden="true">↑</span>
    <span class="products-backtop-label">カテゴリ先頭へ</span>
  </button>
</section>

<section class="bg-kufu-gray-950 text-kufu-white">
  <div class="mx-auto grid w-full max-w-360 gap-8 px-5 py-16 sm:px-8 md:grid-cols-[1fr_auto] md:items-center lg:px-14">
    <div class="grid gap-3">
      <p class="font-mono text-[0.6875rem] font-medium tracking-[0.22em] text-primary-soft">
        MAKER SEARCH
      </p>
      <h2 class="font-serif text-[2rem] font-semibold leading-normal">
        掲載のないメーカー・型番も確認します。
      </h2>
      <p class="max-w-180 text-sm leading-[1.8] text-kufu-gray-200">
        メーカー名、型番、数量、希望納期が分かる場合は、問い合わせ時にご記入ください。代替品や別作加工の可否も含めて確認します。
      </p>
    </div>
    <a
      class="inline-flex min-h-13 items-center justify-center gap-3 bg-primary px-6 text-[0.9375rem] font-semibold text-kufu-white hover:opacity-90"
      href="/contact"
      data-contact-cta
    >
      お問い合わせ・お見積り
      <span class="font-mono text-xs" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<script>
  const normalize = (value: string) =>
    value.toLowerCase().normalize("NFKC").replace(/\s+/g, "");

  const search = document.querySelector<HTMLInputElement>("[data-products-search]");
  const result = document.querySelector<HTMLElement>("[data-products-result]");
  const empty = document.querySelector<HTMLElement>("[data-products-empty]");
  const items = Array.from(
    document.querySelectorAll<HTMLElement>("[data-category-item]"),
  );
  const groups = Array.from(
    document.querySelectorAll<HTMLElement>("[data-products-group]"),
  );
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-target]"),
  );

  // 検索: カテゴリ名 / メーカー名で絞り込み、一致した accordion を開く
  const applyFilter = (raw: string) => {
    const query = normalize(raw);
    let matchCount = 0;

    items.forEach((item) => {
      const details = item.querySelector<HTMLDetailsElement>("details");
      const makers = Array.from(item.querySelectorAll<HTMLElement>("[data-maker]"));
      const nameMatch = normalize(item.dataset.categoryName ?? "").includes(query);

      let makerMatch = false;
      makers.forEach((maker) => {
        const hit =
          query === "" || nameMatch ||
          normalize(maker.dataset.maker ?? "").includes(query);
        maker.hidden = !hit;
        if (hit && query !== "") {
          makerMatch = true;
        }
      });

      const visible = query === "" || nameMatch || makerMatch;
      item.hidden = !visible;
      if (visible) {
        matchCount += 1;
      }
      if (details && query !== "" && visible) {
        details.open = true;
      }
    });

    groups.forEach((group) => {
      const anyVisible = group.querySelector<HTMLElement>(
        "[data-category-item]:not([hidden])",
      );
      group.hidden = !anyVisible;
    });

    navLinks.forEach((link) => {
      const target = link.dataset.navTarget ?? "";
      const item = document.getElementById(target);
      link.classList.toggle("is-dimmed", Boolean(item?.hidden));
    });

    if (result) {
      if (query === "") {
        result.hidden = true;
      } else {
        result.hidden = false;
        result.textContent = `${matchCount}件のカテゴリが一致`;
      }
    }
    if (empty) {
      empty.classList.toggle("hidden", matchCount !== 0);
    }
  };

  search?.addEventListener("input", () => applyFilter(search.value));

  document
    .querySelector("[data-expand-all]")
    ?.addEventListener("click", () => {
      items.forEach((item) => {
        const details = item.querySelector<HTMLDetailsElement>("details");
        if (details) details.open = true;
      });
    });

  document
    .querySelector("[data-collapse-all]")
    ?.addEventListener("click", () => {
      items.forEach((item) => {
        const details = item.querySelector<HTMLDetailsElement>("details");
        if (details) details.open = false;
      });
    });

  // scrollspy: 索引ナビの現在地をハイライト
  if (items.length > 0) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const id = entry.target.id;
          navLinks.forEach((link) =>
            link.classList.toggle(
              "is-active",
              link.dataset.navTarget === id,
            ),
          );
        });
      },
      { rootMargin: "-30% 0px -60% 0px", threshold: 0 },
    );
    items.forEach((item) => spy.observe(item));
  }

  // カテゴリ一覧セクションにいる間だけ「先頭へ戻る」ボタンを表示
  const backtop = document.querySelector<HTMLButtonElement>("[data-products-backtop]");
  const categoryGroups = document.getElementById("products-category-groups");
  const indexTop = document.getElementById("products-category-list");

  if (backtop && categoryGroups && indexTop) {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          backtop.hidden = !entry.isIntersecting;
        });
      },
      { rootMargin: "-15% 0px -10% 0px", threshold: 0 },
    );
    sectionObserver.observe(categoryGroups);

    backtop.addEventListener("click", () => {
      indexTop.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }
</script>
