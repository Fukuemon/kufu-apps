---
import { getCollection } from "astro:content";

import SectionHeading from "../../common/SectionHeading.astro";
import FeaturedCategoryCard from "./FeaturedCategoryCard.astro";

const productCategories = (await getCollection("productCategories")).sort(
  (a, b) => a.data.order - b.data.order,
);
const categoryMakers = await getCollection("categoryMakers");
const makerCountsByCategoryId = new Map(
  categoryMakers.map((entry) => [entry.data.categoryId, entry.data.makers.length]),
);

// 画像を持つカテゴリのみカルーセルに載せる (画像がなければ表示しない方針)
const carouselCategories = productCategories.filter(
  (category) => category.data.featuredImage,
);

// 索引リストは連番のカテゴリを列数で等分する (カテゴリ数の増減に追従する)
const columnCount = 3;
const columnSize = Math.ceil(productCategories.length / columnCount);
const categoryColumns = Array.from({ length: columnCount }, (_, index) =>
  productCategories.slice(index * columnSize, (index + 1) * columnSize),
);
---

<section
  id="products"
  class="products-catalog reveal-section border-b border-border bg-muted"
  data-testid="home-section-products"
>
  <div class="mx-auto grid w-full max-w-360 gap-14 px-5 py-14 sm:px-8 md:gap-16 md:py-20 lg:px-14">
    <div class="grid gap-8">
      <SectionHeading
        number="02"
        eyebrow="PRODUCTS & MAKERS / 取扱製品・取扱メーカー"
        title="取扱製品カテゴリ"
        description={"減速機や軸受などの駆動・伝動部品から、空圧・油圧、工具、測定機器、工場設備まで。\n調達のご相談に応える領域を18のカテゴリに整理しています。"}
      />
    </div>

    <div class="grid gap-8">
      <div
        class="featured-carousel reveal-section relative min-w-0"
        data-testid="home-products-carousel"
        data-featured-carousel
      >
        <div
          class="featured-carousel-viewport flex w-full min-w-0 max-w-full gap-5 overflow-x-auto"
          data-carousel-track
          tabindex="0"
          role="group"
          aria-label="取扱製品カテゴリ カルーセル（横スクロール・左右ボタンで操作）"
        >
          {
            [...carouselCategories, ...carouselCategories, ...carouselCategories].map((category, index) => (
              <div
                class="featured-carousel-item w-64 shrink-0"
                aria-hidden={index >= carouselCategories.length ? "true" : undefined}
              >
                <FeaturedCategoryCard
                  category={`CATEGORY ${String(category.data.order).padStart(2, "0")}`}
                  count={`${makerCountsByCategoryId.get(category.id) ?? 0}社`}
                  title={`${category.data.name}`}
                  image={category.data.featuredImage}
                />
              </div>
            ))
          }
        </div>
        <button
          type="button"
          class="featured-carousel-arrow featured-carousel-arrow--prev"
          data-carousel-prev
          aria-label="前のカテゴリ"
        >
          ←
        </button>
        <button
          type="button"
          class="featured-carousel-arrow featured-carousel-arrow--next"
          data-carousel-next
          aria-label="次のカテゴリ"
        >
          →
        </button>
      </div>

      <div class="catalog-board border border-border bg-card p-4 md:p-7">
        <ol
          class="grid list-none gap-7 md:grid-cols-3 md:gap-12"
          data-testid="products-category-list"
        >
          {
            categoryColumns.map((column) => (
              <li>
                <ol class="grid list-none">
                  {column.map((category) => (
                    <li class="border-t border-border last:border-b">
                      <a
                        class="catalog-row group grid min-h-11 grid-cols-[4.5rem_1fr_auto] items-center gap-3 py-3 hover:text-primary"
                        href={`/products#${category.id}`}
                      >
                        <span class="font-mono text-[0.6875rem] font-medium tracking-[0.16em] text-primary">
                          {String(category.data.order).padStart(2, "0")}
                        </span>
                        <span class="font-serif text-[0.9375rem] font-semibold leading-normal">
                          {category.data.name}
                        </span>
                        <span class="text-right text-[0.71875rem] text-muted-foreground">
                          {makerCountsByCategoryId.get(category.id) ?? 0}社
                        </span>
                      </a>
                    </li>
                  ))}
                </ol>
              </li>
            ))
          }
        </ol>
      </div>

      <a
        class="products-summary-cta grid min-h-16 grid-cols-[1fr_auto] items-center gap-6 px-7 py-[1.375rem] text-[0.875rem] font-medium"
        href="/products"
        data-testid="home-link-products"
      >
        <span>各カテゴリの取扱メーカー一覧は、取扱製品ページに掲載しています。</span>
        <span class="font-semibold">取扱製品ページへ →</span>
      </a>
    </div>
  </div>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-featured-carousel]");
  const track = carousel?.querySelector<HTMLElement>("[data-carousel-track]");

  if (carousel && track && track.children.length > 0) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    // 3コピー分を並べ、中央コピーを基準に前後どちらへも無限ループさせる
    const setCount = track.children.length / 3;

    const stepWidth = () => {
      const first = track.children[0] as HTMLElement;
      const second = track.children[1] as HTMLElement | undefined;
      return second
        ? second.offsetLeft - first.offsetLeft
        : first.getBoundingClientRect().width;
    };

    // 毎フレームの layout 読み取りを避けるため寸法をキャッシュする
    let unit = stepWidth();
    let oneSet = unit * setCount;

    const measure = () => {
      unit = stepWidth();
      oneSet = unit * setCount;
    };

    const center = () => {
      track.scrollLeft = oneSet;
    };

    // 端のコピーに入ったら、見た目を変えずに中央コピーへ巻き戻す
    const recenter = () => {
      if (track.scrollLeft <= oneSet * 0.5) {
        track.scrollLeft += oneSet;
      } else if (track.scrollLeft >= oneSet * 1.5) {
        track.scrollLeft -= oneSet;
      }
    };

    const move = (direction: number) => {
      track.scrollBy({
        left: unit * direction,
        behavior: reduceMotion.matches ? "auto" : "smooth",
      });
    };

    requestAnimationFrame(() => {
      measure();
      center();
    });
    window.addEventListener("resize", () => {
      measure();
      center();
    });

    let recenterTimer = 0;
    track.addEventListener("scroll", () => {
      window.clearTimeout(recenterTimer);
      recenterTimer = window.setTimeout(recenter, 80);
    });

    carousel
      .querySelector("[data-carousel-prev]")
      ?.addEventListener("click", () => move(-1));
    carousel
      .querySelector("[data-carousel-next]")
      ?.addEventListener("click", () => move(1));

    // マウスドラッグで左右に動かせるようにする（タッチは native の横スクロールに任せる）
    let dragging = false;
    let startX = 0;
    let startScroll = 0;

    track.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse") return;
      dragging = true;
      startX = event.clientX;
      startScroll = track.scrollLeft;
      track.classList.add("is-dragging");
      track.setPointerCapture(event.pointerId);
    });

    track.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      event.preventDefault();
      track.scrollLeft = startScroll - (event.clientX - startX);
    });

    const endDrag = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      track.classList.remove("is-dragging");
      if (track.hasPointerCapture(event.pointerId)) {
        track.releasePointerCapture(event.pointerId);
      }
      recenter();
    };

    track.addEventListener("pointerup", endDrag);
    track.addEventListener("pointercancel", endDrag);

    // 画像が自動で流れるよう連続スクロール。ホバー・フォーカス・ドラッグ中は停止
    if (!reduceMotion.matches) {
      let paused = false;
      const speed = 0.5; // px/frame（約30px/秒のゆっくりした流れ）
      const tick = () => {
        if (!paused && !dragging) {
          track.scrollLeft += speed;
          recenter();
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);

      const pause = () => {
        paused = true;
      };
      const resume = () => {
        paused = false;
      };
      carousel.addEventListener("pointerenter", pause);
      carousel.addEventListener("pointerleave", resume);
      carousel.addEventListener("focusin", pause);
      carousel.addEventListener("focusout", resume);
    }
  }
</script>
