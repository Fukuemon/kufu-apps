---
export interface Props {
  label: string;
  value: string;
  href?: string;
}

const { label, value, href } = Astro.props;
---

<div class="contact-info-row">
  <p class="contact-info-row__key">{label}</p>
  <p class="contact-info-row__value">
    {
      href ? (
        <a class="contact-info-row__link" href={href}>
          {value}
        </a>
      ) : (
        value
      )
    }
  </p>
</div>

<style>
  .contact-info-row {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    inline-size: 100%;
    color: var(--foreground);
  }

  .contact-info-row__key,
  .contact-info-row__value {
    margin: 0;
  }

  .contact-info-row__key {
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.145em;
  }

  .contact-info-row__value {
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .contact-info-row__link {
    color: var(--foreground);
    text-decoration-color: var(--primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .contact-info-row__link:hover {
    color: var(--primary);
  }
</style>
