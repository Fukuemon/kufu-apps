{
  "name": "@kufu/corporate-site",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4321",
    "lint": "oxlint --type-aware --config .oxlintrc.json astro.config.mjs vitest.config.ts",
    "token:check": "node scripts/check-token-usage.mjs",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "e2e:serve": "pnpm build && pnpm preview",
    "astro": "astro",
    "storybook": "storybook dev --host 127.0.0.1 --port 6007",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@kufu/config": "workspace:*",
    "@kufu/ui": "workspace:*",
    "astro": "^6.3.1",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@storybook-astro/framework": "^1.5.0",
    "@tailwindcss/vite": "^4.3.1",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
