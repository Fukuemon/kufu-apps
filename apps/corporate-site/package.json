{
  "name": "@kufu/corporate-site",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4321",
    "lint": "oxlint --type-aware --config .oxlintrc.json astro.config.mjs vitest.config.ts && node scripts/check-token-usage.mjs && node scripts/check-section-boundary.mjs",
    "token:check": "node scripts/check-token-usage.mjs",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "e2e:serve": "pnpm build && pnpm preview --ignore-lock",
    "astro": "astro",
    "storybook": "storybook dev --host 127.0.0.1 --port 6007",
    "storybook:build": "storybook build",
    "vrt:capture": "test-storybook --url http://127.0.0.1:6012 --maxWorkers=4"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.5",
    "@kufu/config": "workspace:*",
    "@kufu/ui": "workspace:*",
    "astro": "^7.4.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@storybook-astro/framework": "^1.10.0",
    "@storybook/addon-docs": "10.5.9",
    "@storybook/react": "10.5.9",
    "@storybook/test-runner": "0.24.4",
    "@storycap-testrun/node": "2.1.1",
    "@tailwindcss/vite": "^4.3.1",
    "storybook": "^10.5.9",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
